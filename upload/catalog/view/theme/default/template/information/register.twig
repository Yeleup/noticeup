{{ header }}
<div class="main">
  <!-- Sign up form -->
  <section class="signup">
    <div class="content">
      <div class="signup-content">
        <div class="signup-form">
          <h2 class="form-title">Регистрация</h2>
          <form method="POST" class="register-form" id="register-form">
            <div class="form-group">
              <label for="name"><i class="material-icons-name"></i></label>
              <input type="text" name="name" placeholder="Названия компании" value="{{ name }}"/>
                {% if error_name %}
                  <div class="text-danger">{{ error_name }}</div>
                {% endif %}
            </div>
            <div class="form-group">
              <label for="owner"><i class="zmdi material-icons-name"></i></label>
              <input type="text" name="owner" placeholder="Владелец" value="{{ owner }}"/>
                {% if error_owner %}
                  <div class="text-danger">{{ error_owner }}</div>
                {% endif %}
            </div>
            <div class="form-group">
              <label for="address"><i class="material-icons-name"></i></label>
              <input type="text" name="address" placeholder="Адрес" value="{{ address }}"/>
                {% if error_address %}
                  <div class="text-danger">{{ error_address }}</div>
                {% endif %}
            </div>
            <div class="form-group">
              <label for="phone"><i class="zmdi"></i></label>
              <input name="phone" placeholder="Телефон" value="{{ phone }}"/>
                {% if error_phone %}
                  <div class="text-danger">{{ error_phone }}</div>
                {% endif %}
            </div>
            <div class="form-group">
              <label for="email"><i class="zmdi"></i></label>
              <input type="email" name="email" placeholder="Почта" value="{{ email }}"/>
              {% if error_email %}
                <div class="text-danger">{{ error_email }}</div>
              {% endif %}
            </div>
            <div class="form-group form-button">
              <input type="submit" name="signup" id="signup" class="form-submit" value="Регистрация"/>
            </div>
          </form>
        </div>
        <div class="signup-image">
          <figure><img src="image/signup-image.jpg" alt="sing up image"></figure>
          <a href="{{ admin }}" class="signup-image-link">У меня есть аккаунт</a>
        </div>
      </div>
    </div>
  </section>
</div>
{{ footer }}