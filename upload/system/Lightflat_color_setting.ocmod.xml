<?xml version="1.0" encoding="utf-8"?>
<modification>
    <name>Lightflat Color Setting</name>
    <code>Lightflat Color Setting</code>
    <version>1.0</version>
	<file path="catalog/controller/common/header.php">
		<operation>
			<search><![CDATA[
			$data['title'] = $this->document->getTitle();
			]]></search>
			<add position="after"><![CDATA[
			$data['lightflat_setting'] = $this->load->controller('common/lightflat_setting');
	        ]]></add>
		</operation>
	</file>
    <file path="catalog/view/theme/lightflat/template/common/header.twig">
		<operation>
			<search><![CDATA[
			</head>
			]]></search>
			<add position="before"><![CDATA[
			{{ lightflat_setting }}
	        ]]></add>
		</operation>
	</file>
</modification>