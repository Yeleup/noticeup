    </file>
    <file path="catalog/controller/common/footer.php">
        <operation>
            <search><![CDATA[
                $data['powered'] = sprintf($this->language->get('text_powered'), $this->config->get('config_name'), date('Y', time()));
            ]]></search>
            <add position="before"><![CDATA[
                $data['facebook'] = $this->config->get('config_facebook');  
                $data['vk'] = $this->config->get('config_vk');  
                $data['odnoclass'] = $this->config->get('config_odnoclass');  
                $data['youtube'] = $this->config->get('config_youtube');  
                $data['twitter'] = $this->config->get('config_twitter');  
                $data['instagram'] = $this->config->get('config_instagram');
            ]]></add>
        </operation>
    </file>
    <!-- Owl carousel-->
    <file path="catalog/controller/extension/module/{banner,slideshow,carousel}.php">
        <operation>
            <search><![CDATA[
                $this->document->addStyle('catalog/view/javascript/jquery/swiper/css/swiper.min.css');   
            ]]></search>
            <add position="before"><![CDATA[
            if ($this->config->get('config_theme') == 'lightflat') {
                $this->document->addStyle('catalog\view\theme\lightflat\js\jquery\owl-carousel/owl.carousel.css');
		        $this->document->addStyle('catalog\view\theme\lightflat\js\jquery\owl-carousel/owl.transitions.css');
		        $this->document->addScript('catalog\view\theme\lightflat\js\jquery\owl-carousel/owl.carousel.min.js');   
            }
            ]]></add>
        </operation>
    </file>
</modification>