		        }

                if (isset($this->request->post['config_odnoclass'])) {
			    $data['config_odnoclass'] = $this->request->post['config_odnoclass'];
		        } else {
			    $data['config_odnoclass'] = $this->config->get('config_odnoclass');
		        }

