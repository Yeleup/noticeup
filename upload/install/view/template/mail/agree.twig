<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01//EN" "http://www.w3.org/TR/1999/REC-html401-19991224/strict.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>{{ title }}</title>
</head>
<body style="font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #000000;">
<div style="width: 680px;">
  <table>
    <tr>
      <td>
        <div style="float: right; margin-left: 20px;"><a href="{{ store_url }}" title="{{ store_name }}"><img src="{{ image }}" alt="{{ store_name }}" style="margin-bottom: 20px; border: none;" /></a></div>
      </td>
    </tr>
    <tr>
      <td>
        {{ text_approval }}
      </td>
    </tr>
    <tr>
      <td>
        <h1 style="color: #2fc5f0; text-decoration: underline">{{ login }}</h1>
      </td>
    </tr>
    <tr>
      <td>
        {{ text_thanks }} {{ store_name }}
      </td>
    </tr>
    <tr>
      <td>
        <a href="{{ store_url }}" title="{{ store_name }}">{{ store_url }}</a>
      </td>
    </tr>
  </table>
</div>
</body>
</html>
