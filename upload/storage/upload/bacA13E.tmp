\n\t\t\t}\n\t\t\t  ]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[\n\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "order` WHERE order_status_id IN(" . implode(",", $implode) . ") AND YEAR(date_added) = YEAR(NOW()) GROUP BY MONTH(date_added)");\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[ \t\t\t \n\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\tif($userac->user_group_name==\'Store admin\') {\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "order` WHERE order_status_id IN(" . implode(",", $implode) . ") AND YEAR(date_added) = YEAR(NOW()) AND store_id=".$userac->store_id." GROUP BY MONTH(date_added)");\t\t\t\t\n\t\t\t}else{\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "order` WHERE order_status_id IN(" . implode(",", $implode) . ") AND YEAR(date_added) = YEAR(NOW()) GROUP BY MONTH(date_added)");\n\t\t\t}\n\t\t\t  ]]></add>\n\t\t</operation>\t\t\n\t</file>\n\t<!-- Customer report -->\n\t<file path="admin/model/report/customer.php">\t\t\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[\n\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, HOUR(date_added) AS hour FROM `" . DB_PREFIX . "customer` WHERE DATE(date_added) = DATE(NOW()) GROUP BY HOUR(date_added) ORDER BY date_added ASC");\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[\t\t\t \n\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\tif($userac->user_group_name==\'Store admin\') {\t\t\t\t\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, HOUR(c.date_added) AS hour FROM `" . DB_PREFIX . "customer` c \n\t\t\t\tINNER JOIN `" . DB_PREFIX . "order` o ON o.customer_id = c.customer_id  \t\t\t\t\n\t\t\t\tWHERE DATE(c.date_added) = DATE(NOW()) AND o.store_id=".$userac->store_id." GROUP BY HOUR(c.date_added) ORDER BY c.date_added ASC");\n\t\t\t} else {\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, HOUR(date_added) AS hour FROM `" . DB_PREFIX . "customer` WHERE DATE(date_added) = DATE(NOW()) GROUP BY HOUR(date_added) ORDER BY date_added ASC");\n\t\t\t}\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[\n\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "customer` WHERE DATE(date_added) >= DATE(\'" . $this->db->escape(date(\'Y-m-d\', $date_start)) . "\') GROUP BY DAYNAME(date_added)");\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[\t\t\t \n\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\tif($userac->user_group_name==\'Store admin\') {\t\t\t\t\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, c.date_added FROM `" . DB_PREFIX . "customer` c\n\t\t\t\tINNER JOIN `" . DB_PREFIX . "order` o ON o.customer_id = c.customer_id\n\t\t\t\tWHERE DATE(c.date_added) >= DATE(\'" . $this->db->escape(date(\'Y-m-d\', $date_start)) . "\') AND o.store_id=".$userac->store_id." GROUP BY DAYNAME(c.date_added)");\n\t\t\t} else {\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "customer` WHERE DATE(date_added) >= DATE(\'" . $this->db->escape(date(\'Y-m-d\', $date_start)) . "\') GROUP BY DAYNAME(date_added)");\n\t\t\t}\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[\n\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "customer` WHERE DATE(date_added) >= \'" . $this->db->escape(date(\'Y\') . \'-\' . date(\'m\') . \'-1\') . "\' GROUP BY DATE(date_added)");\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[\t\t\t \n\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\tif($userac->user_group_name==\'Store admin\') {\t\t\t\t\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, c.date_added FROM `" . DB_PREFIX . "customer` c\n\t\t\t\tINNER JOIN `" . DB_PREFIX . "order` o ON o.customer_id = c.customer_id\n\t\t\t\tWHERE o.store_id=".$userac->store_id." AND DATE(c.date_added) >= \'" . $this->db->escape(date(\'Y\') . \'-\' . date(\'m\') . \'-1\') . "\' GROUP BY DATE(c.date_added)");\n\t\t\t} else {\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "customer` WHERE DATE(date_added) >= \'" . $this->db->escape(date(\'Y\') . \'-\' . date(\'m\') . \'-1\') . "\' GROUP BY DATE(date_added)");\n\t\t\t}\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[\n\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "customer` WHERE YEAR(date_added) = YEAR(NOW()) GROUP BY MONTH(date_added)");\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[\t\t\t \n\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\tif($userac->user_group_name==\'Store admin\') {\t\t\t\t\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, c.date_added FROM `" . DB_PREFIX . "customer` c\n\t\t\t\tINNER JOIN `" . DB_PREFIX . "order` o ON o.customer_id = c.customer_id\n\t\t\t\tWHERE YEAR(c.date_added) = YEAR(NOW()) AND o.store_id=".$userac->store_id." GROUP BY MONTH(c.date_added)");\n\t\t\t} else {\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "customer` WHERE YEAR(date_added) = YEAR(NOW()) GROUP BY MONTH(date_added)");\n\t\t\t}\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[\n\t\t\tif (!empty($data[\'filter_order_status_id\'])) {\n\t\t\t]]></search>\n\t\t\t<add position="before"><![CDATA[\t\t\t \n\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\tif($userac->user_group_name==\'Store admin\') {\t\t\t\t\n\t\t\t\t$sql .= " AND o.store_id=".$userac->store_id;\n\t\t\t}\n\t\t\t]]></add>\n\t\t</operation>\n\t</file>\t\n\t<!-- Manage user -->\n\t<file path="admin/view/template/user/user_form.twig">\t\n\t\t<operation error="skip"> \n\t\t\t<search index="0"><![CDATA[<div class="form-group">]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t\t{% if user_group_name==\'Store admin\'%}\n\t\t\t\t\t<div class="form-group" style="display:none;">\n\t\t\t\t{% else %}\n\t\t\t\t\t<div class="form-group">\n\t\t\t\t{% endif %}\n\t\t\t]]>\n\t\t\t</add>\t\t  \n\t\t</operation>\n\t\t<operation error="skip"> \n\t\t\t<search index="0"><![CDATA[<option value="{{ user_group.user_group_id }}">{{ user_group.name }}</option>]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t\t{% if user_group_name==\'Store admin\'%}\n\t\t\t\t\t{% if user_group.name==\'Store admin\' %}\n\t\t\t\t\t\t<option value="{{ user_group.user_group_id }}" selected="selected">{{ user_group.name }}</option>\n\t\t\t\t\t{% endif %}\t\n\t\t\t\t{% else %}\n\t\t\t\t\t<option value="{{ user_group.user_group_id }}">{{ user_group.name }}</option>\n\t\t\t\t{% endif %}\n\t\t\t]]>\n\t\t\t</add>\t\t  \n\t\t</operation>\n\t\t<operation error="skip"> \n\t\t\t<search><![CDATA[<label class="col-sm-2 control-label" for="input-user-group">{{entry_store}}</label>]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t\t{% if user_group_name==\'Store admin\'%}\n\t\t\t\t\t<label style="display:none;" class="col-sm-2 control-label" for="input-user-group">{{entry_store}}</label>\t\n\t\t\t\t{% else %}\n\t\t\t\t\t<label class="col-sm-2 control-label" for="input-user-group">{{entry_store}}</label>\n\t\t\t\t{% endif %}\n\t\t\t]]>\n\t\t\t</add>\t\t  \n\t\t</operation>\n\t\t<operation error="skip"> \n\t\t\t<search index="2"><![CDATA[<div class="col-sm-10">]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t\t{% if user_group_name==\'Store admin\'%}\n\t\t\t\t\t<div style="display:none;" class="col-sm-10">\n\t\t\t\t{% else %}\n\t\t\t\t\t<div class="col-sm-10">\n\t\t\t\t{% endif %}\n\t\t\t]]>\n\t\t\t</add>\t\t  \n\t\t</operation>\t\t\n\t</file>\n\t<!-- Hide Menus -->\t\n\t<file path="admin/view/template/common/header.twig">\t\t\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[<body>]]></search>\n\t\t\t<add position="after"><![CDATA[\n\t\t\t<script type="text/javascript">\t\t\t\n\t\t\t$(document).ready(function() {\n\t\t\t\tif($(\'#menu-report\').find(\'ul\').length==0){\n\t\t\t\t\t$(\'#menu-report\').hide();\n\t\t\t\t}\n\t\t\t\tif($(\'#menu-system li\').length==6){\t\t\t\t\t\n\t\t\t\t\t$.each($(\'#menu-system li a\'), function () {\n\t\t\t\t\t\tvar menu_name = $(this).html();\n\t\t\t\t\t\tif(menu_name==\'Settings\'||menu_name==\'API\'||menu_name==\'Localisation\'){\n\t\t\t\t\t\t\t$(this).parent().hide();\n\t\t\t\t\t\t}\t\n\t\t\t\t\t})\n\t\t\t\t}\n\t\t\t});\n\t\t\t</script>\t\n\t\t\t]]></add>\n\t\t</operation>\n\t</file>\t\n</modification>', '0', '2020-07-29 12:10:28');
INSERT INTO `oc_modification` (`modification_id`, `extension_install_id`, `name`, `code`, `author`, `version`, `link`, `xml`, `status`, `date_added`) VALUES ('27', '0', 'Architect #34 - Admin store', 'architect_arc5f2be4a406692', 'Ataul Haque magzhan9292', '3.0.0.0', 'http://oc.mightytech.org', '<modification>\r\n    <name>Architect #34 - Admin store</name>\r\n    <version>3.0.0.0</version>\r\n    <link>http://oc.mightytech.org</link>\r\n    <author>Ataul Haque magzhan9292</author>\r\n    <code>admin_store.ocmod</code>\r\n\r\n\t<file path="admin/language/en-gb/user/user.php">\t\r\n\t\t<operation error="skip"> \r\n\t\t\t<search><![CDATA[$_[\'entry_user_group\']      = \'User Group\';]]></search>\r\n\t\t  <add position="after"><![CDATA[$_[\'entry_store\'] \t\t= \'Store\';]]>\r\n\t\t  </add>\t\t  \r\n\t\t</operation>\r\n\t</file>\t\t\t\r\n\t<file path="admin/view/template/user/user_form.twig">\r\n\t\t<operation error="skip"> \r\n\t\t\t<search ><![CDATA[<option value="{{ user_group.user_group_id }}">{{ user_group.name }}</option>]]></search>\r\n\t\t  <add position="after"><![CDATA[\r\n\t\t\t\t\t{% endif %}\r\n                {% endfor %}\r\n              </select>\r\n            </div>\r\n          </div>\r\n\t\t  <div class="form-group {{ store_id_container_class}}" id="store_id_container">\r\n\t\t\t<script>\r\n\t\t\t$(document).ready(function() {\r\n\t\t\t\tvar user_group = $("#input-user-group option[value="+$(\'#input-user-group\').val()+"]").text();\t\r\n\t\t\t\t{% if user_group_name!=\'Store admin\'%}\r\n\t\t\t\tif(user_group==\'Store admin\'){\r\n\t\t\t\t\t$(\'#store_id_container\').removeClass(\'hide\');\r\n\t\t\t\t}\r\n\t\t\t\t{% endif %}\r\n\t\t\t});\r\n\t\t\t$(\'#input-user-group\').change(function(){\r\n\t\t\t\tvar user_group_id = $(this).val();\t\r\n\t\t\t\tvar user_group = $("#input-user-group option[value="+user_group_id+"]").text();\t\r\n\t\t\t\tif(user_group==\'Store admin\'){\r\n\t\t\t\t\t{% if user_group_name!=\'Store admin\'%}\r\n\t\t\t\t\t\t$(\'#store_id_container\').removeClass(\'hide\');\r\n\t\t\t\t\t{% endif %}\t\r\n\t\t\t\t}else{\r\n\t\t\t\t\t$(\'#store_id_container\').addClass(\'hide\');\r\n\t\t\t\t}\r\n\t\t\t})\r\n\t\t\t</script>\r\n            <label class="col-sm-2 control-label" for="input-user-group">{{entry_store}}</label>\r\n            <div class="col-sm-10">\r\n              <select name="store_id" id="input-store-id" class="form-control">\r\n                {% for store in stores %}\r\n                {% if store.store_id in store_id %}\r\n\t\t\t\t\t<option value="{{store.store_id}}" selected="selected">{{store.name}}</option>\r\n                {% else %}\r\n\t\t\t\t\t<option value="{{store.store_id}}">{{store.name}}</option>\r\n                \t\t  \r\n\t\t  ]]>\r\n\t\t  </add>\t\t  \r\n\t\t</operation>\r\n\t</file>\r\n\t<file path="admin/controller/user/user.php">\r\n\t\t<operation error="skip"> \r\n\t\t\t<search ><![CDATA[\r\n\t\t\t$data[\'user_groups\'] = $this->model_user_user_group->getUserGroups();]]></search>\r\n\t\t  <add position="after"><![CDATA[$data[\'entry_store\'] = $this->language->get(\'entry_store\');\t\t\r\n\t\tif(isset($user_info)&&$user_info[\'user_group\']==\'Store admin\'){\r\n\t\t\t$data[\'store_id_container_class\'] = \'\';\r\n\t\t\t$data[\'store_id\'] = $user_info[\'store_id\'];\r\n\t\t}else{\r\n\t\t\t$data[\'store_id_container_class\'] = \'hide\';\r\n\t\t\tif(!isset($data[\'store_id\']))\r\n\t\t\t\t$data[\'store_id\'] = 0;\r\n\t\t}\r\n\t\t$this->load->model(\'setting/store\');\r\n\t\t$data[\'stores\'] = $this->model_setting_store->getStores();\r\n\t\t$data[\'config_name\'] = $this->config->get(\'config_name\');\t\t\r\n\t\t]]>\r\n\t\t  </add>\t\t  \r\n\t\t</operation>\r\n\t\t<operation error="skip"> \r\n\t\t\t<search ><![CDATA[protected function getForm() {]]></search>\r\n\t\t  <add position="after"><![CDATA[\r\n\t\t\t$userac = $this->registry->get(\'user\');\t\t\r\n\t\t\t$data[\'user_group_name\'] = $userac->user_group_name;\r\n\t\t\t$data[\'store_id\'] = $userac->store_id;\t\t\t\t\r\n\t\t]]>\r\n\t\t  </add>\t\t  \r\n\t\t</operation>\t\t\r\n\t</file>\r\n\t<file path="admin/model/user/user.php">\r\n\t\t<operation error="skip"> \r\n\t\t\t<search ><![CDATA[$this->db->query("INSERT INTO `" . DB_PREFIX . "user` SET username = \'" . $this->db->escape($data[\'username\']) . "\', user_group_id = \'" . (int)$data[\'user_group_id\'] . "\', salt = \'" . $this->db->escape($salt = token(9)) . "\', password = \'" . $this->db->escape(sha1($salt . sha1($salt . sha1($data[\'password\'])))) . "\', firstname = \'" . $this->db->escape($data[\'firstname\']) . "\', lastname = \'" . $this->db->escape($data[\'lastname\']) . "\', email = \'" . $this->db->escape($data[\'email\']) . "\', image = \'" . $this->db->escape($data[\'image\']) . "\', status = \'" . (int)$data[\'status\'] . "\', date_added = NOW()");]]></search>\r\n\t\t  <add position="replace"><![CDATA[\r\n\t\t\t$this->load->model(\'user/user_group\');\r\n\t\t$user_group = $this->model_user_user_group->getUserGroup($data[\'user_group_id\']);\t\t\r\n\t\tif($user_group[\'name\']==\'Store admin\'){\r\n\t\t\t$store_id = $data[\'store_id\'];\r\n\t\t}else{\r\n\t\t\t$store_id = 0;\r\n\t\t}\t\t\r\n\t\t$query = "INSERT INTO `" . DB_PREFIX . "user` SET username = \'" . $this->db->escape($data[\'username\']) . "\', user_group_id = \'" . (int)$data[\'user_group_id\'] ."\' , store_id = \'" . $store_id . "\', salt = \'" . $this->db->escape($salt = token(9)) . "\', password = \'" . $this->db->escape(sha1($salt . sha1($salt . sha1($data[\'password\'])))) . "\', firstname = \'" . $this->db->escape($data[\'firstname\']) . "\', lastname = \'" . $this->db->escape($data[\'lastname\']) . "\', email = \'" . $this->db->escape($data[\'email\']) . "\', image = \'" . $this->db->escape($data[\'image\']) . "\', status = \'" . (int)$data[\'status\'] . "\', date_added = NOW()";\r\n\t\t$this->db->query($query);\r\n\t\t  ]]>\r\n\t\t  </add>\t\t  \r\n\t\t</operation>\r\n\t\t<operation error="skip"> \r\n\t\t\t<search ><![CDATA[$this->db->query("UPDATE `" . DB_PREFIX . "user` SET username = \'" . $this->db->escape($data[\'username\']) . "\', user_group_id = \'" . (int)$data[\'user_group_id\'] . "\', firstname = \'" . $this->db->escape($data[\'firstname\']) . "\', lastname = \'" . $this->db->escape($data[\'lastname\']) . "\', email = \'" . $this->db->escape($data[\'email\']) . "\', image = \'" . $this->db->escape($data[\'image\']) . "\', status = \'" . (int)$data[\'status\'] . "\' WHERE user_id = \'" . (int)$user_id . "\'");]]></search>\r\n\t\t\t<add position="replace"><![CDATA[\r\n\t\t  $this->load->model(\'user/user_group\');\r\n\t\t$user_group = $this->model_user_user_group->getUserGroup($data[\'user_group_id\']);\t\t\r\n\t\tif($user_group[\'name\']==\'Store admin\'){\r\n\t\t\t$store_id = $data[\'store_id\'];\r\n\t\t}else{\r\n\t\t\t$store_id = 0;\r\n\t\t}\r\n\t\t$this->db->query("UPDATE `" . DB_PREFIX . "user` SET username = \'" . $this->db->escape($data[\'username\']) . "\', user_group_id = \'" . (int)$data[\'user_group_id\'] . "\', store_id = \'" . $store_id . "\', firstname = \'" . $this->db->escape($data[\'firstname\']) . "\', lastname = \'" . $this->db->escape($data[\'lastname\']) . "\', email = \'" . $this->db->escape($data[\'email\']) . "\', image = \'" . $this->db->escape($data[\'image\']) . "\', status = \'" . (int)$data[\'status\'] . "\' WHERE user_id = \'" . (int)$user_id . "\'");\r\n\t\t]]>\r\n\t\t\t</add>\t\t  \r\n\t\t</operation>\r\n\t\t<operation error="skip"> \r\n\t\t\t<search ><![CDATA[$sql = "SELECT * FROM `" . DB_PREFIX . "user`";]]></search>\r\n\t\t\t<add position="replace"><![CDATA[\r\n\t\t\t\t$userac = $this->registry->get(\'user\');\t\t\r\n\t\t\t\tif($userac->user_group_name==\'Store admin\'){\r\n\t\t\t\t\t$sql = "SELECT * FROM `" . DB_PREFIX . "user` WHERE store_id=".$userac->store_id." AND user_group_id=".$userac->getGroupId();\r\n\t\t\t\t}else{\r\n\t\t\t\t\t$sql = "SELECT * FROM `" . DB_PREFIX . "user`";\r\n\t\t\t\t}\t\t\t\r\n\t\t\t]]>\r\n\t\t\t</add>\r\n\t\t</op