\n\t\t\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\tprotected function getForm() {\n\t\t\t]]></search>\n\t\t\t<add position="after"><![CDATA[\n\t\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\t\t$data[\'user_group_name\'] = $userac->user_group_name;\n\t\t\t\t$data[\'user_store_id\'] = $userac->store_id;\n\t\t\t]]></add>\n\t\t</operation>\n\t</file>\n\t<file path="admin/view/template/catalog/category_form.twig">\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t<label class="col-sm-2 control-label">{{ entry_store }}</label>\n\t\t\t]]></search>\n\t\t\t<add position="before"><![CDATA[\n\t\t\t\t{% if user_group_name==\'Store admin\'%}\n\t\t\t\t\t<input type="checkbox" style="display:none" name="category_store[]" value="{{user_store_id}}" checked="checked" /><!--\n\t\t\t\t{% endif %}\t\t\t\t\n\t\t\t]]></add>\n\t\t</operation>\t\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t<label class="col-sm-2 control-label">{{ entry_image }}</label>\n\t\t\t]]></search>\n\t\t\t<add position="before"><![CDATA[\n\t\t\t{% if user_group_name==\'Store admin\'%}\n\t\t\t\t-->\n\t\t\t{% endif %}\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t<td class="text-left">{{ store.name }}</td>\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t<td {% if user_group_name==\'Store admin\' and store.store_id!=user_store_id %} style="display:none" {% endif %} class="text-left">{{ store.name }}</td>\t\t\t\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t<td class="text-left"><select name="category_layout[{{ store.store_id }}]" class="form-control">\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t<td {% if user_group_name==\'Store admin\' and store.store_id!=user_store_id %} style="display:none" {% endif %}> class="text-left"><select name="category_layout[{{ store.store_id }}]" class="form-control">\t\t\t\n\t\t\t]]></add>\n\t\t</operation>\t\t\n\t</file>\n\t<!-- Customer filter -->\n\t<file path="admin/model/customer/customer.php">\t\t\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[\n\t\t\tif (isset($data[\'filter_status\']) && $data[\'filter_status\'] !== \'\') {\n\t\t\t]]></search>\n\t\t\t<add position="before"><![CDATA[ \t\t\t\n\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\t$data[\'user_group_name\'] = $userac->user_group_name;\n\t\t\tif($data[\'user_group_name\']==\'Store admin\') {\n\t\t\t\t$filter_store = $userac->store_id;\t\t\t\n\t\t\t\t$implode[] = "store_id = ".(int)$filter_store;\n\t\t\t}]]></add>\n\t\t</operation>\t\t\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[\n\t\t\t$this->db->query("INSERT INTO " . DB_PREFIX . "customer SET customer_group_id = \'" . (int)$data[\'customer_group_id\'] . "\', firstname = \'" . $this->db->escape($data[\'firstname\']) . "\', lastname = \'" . $this->db->escape($data[\'lastname\']) . "\', email = \'" . $this->db->escape($data[\'email\']) . "\', telephone = \'" . $this->db->escape($data[\'telephone\']) . "\', custom_field = \'" . $this->db->escape(isset($data[\'custom_field\']) ? json_encode($data[\'custom_field\']) : json_encode(array())) . "\', newsletter = \'" . (int)$data[\'newsletter\'] . "\', salt = \'" . $this->db->escape($salt = token(9)) . "\', password = \'" . $this->db->escape(sha1($salt . sha1($salt . sha1($data[\'password\'])))) . "\', status = \'" . (int)$data[\'status\'] . "\', safe = \'" . (int)$data[\'safe\'] . "\', date_added = NOW()");\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[ \n\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\t$data[\'user_group_name\'] = $userac->user_group_name;\n\t\t\tif($data[\'user_group_name\']==\'Store admin\') {\n\t\t\t\t$user_store_id = $userac->store_id;\t\t\t\n\t\t\t\t$this->db->query("INSERT INTO " . DB_PREFIX . "customer SET customer_group_id = \'" . (int)$data[\'customer_group_id\'] . "\', firstname = \'" . $this->db->escape($data[\'firstname\']) . "\', lastname = \'" . $this->db->escape($data[\'lastname\']) . "\', email = \'" . $this->db->escape($data[\'email\']) . "\', telephone = \'" . $this->db->escape($data[\'telephone\']) . "\', custom_field = \'" . $this->db->escape(isset($data[\'custom_field\']) ? json_encode($data[\'custom_field\']) : json_encode(array())) . "\', newsletter = \'" . (int)$data[\'newsletter\'] . "\', salt = \'" . $this->db->escape($salt = token(9)) . "\', password = \'" . $this->db->escape(sha1($salt . sha1($salt . sha1($data[\'password\'])))) . "\', status = \'" . (int)$data[\'status\'] . "\', safe = \'" . (int)$data[\'safe\'] . "\', date_added = NOW(), store_id=$user_store_id");\n\t\t\t}else{\n\t\t\t\t$this->db->query("INSERT INTO " . DB_PREFIX . "customer SET customer_group_id = \'" . (int)$data[\'customer_group_id\'] . "\', firstname = \'" . $this->db->escape($data[\'firstname\']) . "\', lastname = \'" . $this->db->escape($data[\'lastname\']) . "\', email = \'" . $this->db->escape($data[\'email\']) . "\', telephone = \'" . $this->db->escape($data[\'telephone\']) . "\', custom_field = \'" . $this->db->escape(isset($data[\'custom_field\']) ? json_encode($data[\'custom_field\']) : json_encode(array())) . "\', newsletter = \'" . (int)$data[\'newsletter\'] . "\', salt = \'" . $this->db->escape($salt = token(9)) . "\', password = \'" . $this->db->escape(sha1($salt . sha1($salt . sha1($data[\'password\'])))) . "\', status = \'" . (int)$data[\'status\'] . "\', safe = \'" . (int)$data[\'safe\'] . "\', date_added = NOW()");\n\t\t\t}\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t\tpublic function getCustomer($customer_id) {\n\t\t\t]]></search>\n\t\t\t<add position="before"><![CDATA[\n\t\t\tpublic function checkCustomerForStore($customer_id){\n\t\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\t\tif($userac->user_group_name==\'Store admin\') {\t\t\t\t\n\t\t\t\t\t$sql = "SELECT count(customer_id) as total FROM " . DB_PREFIX . "customer c WHERE c.customer_id=$customer_id AND c.store_id=".$userac->store_id;\n\t\t\t\t\t$result = $this->db->query($sql)->row;\n\t\t\t\t\tif($result[\'total\']==0){\n\t\t\t\t\t\treturn false;\n\t\t\t\t\t}else{\n\t\t\t\t\t\treturn true;\n\t\t\t\t\t}\t\t\t\n\t\t\t\t}else{\n\t\t\t\t\treturn true;\n\t\t\t\t}\n\t\t\t}\n\t\t\t]]></add>\n\t\t</operation>\t\t\n\t</file>\n\t<!-- Add/Edit Customer -->\n\t<file path="admin/language/en-gb/customer/customer.php">\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t\t// Error\n\t\t\t]]></search>\n\t\t\t<add position="after"><![CDATA[\n\t\t\t$_[\'error_not_found\']        = \'Warning: Customer not found!\';\n\t\t\t]]></add>\n\t\t</operation>\n\t</file>\t\n\t<file path="admin/controller/customer/customer.php">\t\t\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[\n\t\t\t$customer_info = $this->model_customer_customer->getCustomer($this->request->get[\'customer_id\']);\n\t\t\t]]></search>\n\t\t\t<add position="before"><![CDATA[ \n\t\t\tif(!$this->model_customer_customer->checkCustomerForStore($this->request->get[\'customer_id\'])){\n\t\t\t\t$this->session->data[\'error\'] = $this->language->get(\'error_not_found\');\n\t\t\t\t$this->response->redirect($this->url->link(\'customer/customer\', \'user_token=\' . $this->session->data[\'user_token\'] . $url, true));\n\t\t\t}]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[\n\t\t\t$data[\'error_warning\'] = \'\';\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\tif (isset($this->session->data[\'error\'])) {\n\t\t\t\t$data[\'error_warning\'] = $this->session->data[\'error\'];\n\n\t\t\t\tunset($this->session->data[\'error\']);\n\t\t\t} else {\n\t\t\t\t$data[\'error_warning\'] = \'\';\n\t\t\t}\n\t\t]]></add>\n\t\t</operation>\t\t\t\n\t</file>\n\t<!-- File manager -->\t\n\t<file path="admin/controller/common/filemanager.php">        \n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[$directory = DIR_IMAGE . \'catalog\';]]></search>\n\t\t\t<add position="replace"><![CDATA[ \n\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\t$user_group_name = $userac->user_group_name;\n\t\t\t$user_store_id = $userac->store_id;\n\t\t\tif($user_group_name==\'Store admin\'){\n\t\t\t\t$directory = DIR_IMAGE . \'catalog/store_\'.$user_store_id;\n\t\t\t\t$base_directory = DIR_IMAGE . \'catalog/store_\'.$user_store_id;\n\t\t\t}else{\n\t\t\t\t$directory = DIR_IMAGE . \'catalog\';\n\t\t\t\t$base_directory = DIR_IMAGE . \'catalog\';\n\t\t\t}\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[$directory = rtrim(DIR_IMAGE . \'catalog/\' . $this->request->get[\'directory\'], \'/\');]]></search>\n\t\t\t<add position="replace"><![CDATA[ \n\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\t$user_group_name = $userac->user_group_name;\n\t\t\t$user_store_id = $userac->store_id;\n\t\t\tif($user_group_name==\'Store admin\'){\t\t\t\t\n\t\t\t\t$base_directory = DIR_IMAGE . \'catalog/store_\'.$user_store_id;\n\t\t\t}else{\n\t\t\t\t$base_directory = DIR_IMAGE . \'catalog\';\t\t\t\n\t\t\t}\n\t\t\t$directory = rtrim(DIR_IMAGE . \'catalog/\' . $this->request->get[\'directory\'], \'/\');\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[if (!is_dir($directory) || substr(str_replace(\'\\\\\', \'/\', realpath($directory)), 0, strlen(DIR_IMAGE . \'catalog\')) != str_replace(\'\\\\\', \'/\', DIR_IMAGE . \'catalog\')) {]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t\tif (!is_dir($directory) || substr(str_replace(\'\\\\\', \'/\', realpath($directory)), 0, strlen($base_directory)) != $base_directory) {\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[if (substr(str_replace(\'\\\\\', \'/\', realpath($directory) . \'/\' . $filter_name), 0, strlen(DIR_IMAGE . \'catalog\')) == str_replace(\'\\\\\', \'/\', DIR_IMAGE . \'catalog\')) {]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t\tif (substr(str_replace(\'\\\\\', \'/\', realpath($directory) . \'/\' . $filter_name), 0, strlen($base_directory)) == $base_directory) {\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[public function index() {]]></search>\n\t\t\t<add position="after"><![CDATA[\n\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\t$user_group_name = $userac->user_group_name;\n\t\t\t$user_store_id = $userac->store_id;\n\t\t\tif($user_group_name==\'Store admin\'){\n\t\t\t\t$directory = DIR_IMAGE . \'catalog/store_\'.$user_store_id;\n\t\t\t\t$base_directory = DIR_IMAGE . \'catalog/store_\'.$user_store_id;\n\t\t\t}else{\n\t\t\t\t$directory = DIR_IMAGE . \'catalog\';\n\t\t\t\t$base_directory = DIR_IMAGE . \'catalog\';\n\t\t\t}\n\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[$data[\'directory\'] = \'\';]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\t\t$user_group_name = $userac->user_group_name;\n\t\t\t\t$user_store_id = $userac->store_id;\n\t\t\t\tif($user_group_name==\'Store admin\'){\n\t\t\t\t\t$data[\'directory\'] = \'store_\'.$user_store_id;\t\t\t\t\t\n\t\t\t\t}else{\n\t\t\t\t\t$data[\'directory\'] = \'\';\t\t\t\t\t\n\t\t\t\t}\n\t\t\t]]></add>\n\t\t</operation>\n\t</file>\t\n\t<file path="admin/model/setting/store.php">\n\t\t<operation error="skip"> \n\t\t\t<search ><![CDATA[$store_id = $this->db->getLastId();]]></search>\n\t\t\t<add position="after"><![CDATA[\t\n\t\t\t\t//Create store directory\n\t\t\t\t$directory = DIR_IMAGE . \'catalog\';\n\t\t\t\t$folder = \'store_\'.$store_id;\n\t\t\t\t@mkdir($directory . \'/\' . $folder, 0777);\n\t\t\t\t@chmod($directory . \'/\' . $folder, 0777);\n\t\t\t\t@touch($directory . \'/\' . $folder . \'/\' . \'index.html\');\n\t\t\t]]></add>\n\t\t</operation>\n\t</file>\n\t<!-- Modification conflict -->\t\n\t<file path="admin/controller/marketplace/modification.php">\t\n\t\t<operation er