uery = $this->db->query("SELECT COUNT(*) AS total, HOUR(date_added) AS hour FROM `" . DB_PREFIX . "order` WHERE order_status_id IN(" . implode(",", $implode) . ") AND DATE(date_added) = DATE(NOW()) AND store_id=".$userac->store_id." GROUP BY HOUR(date_added) ORDER BY date_added ASC");\r\n\t\t\t}else{\r\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, HOUR(date_added) AS hour FROM `" . DB_PREFIX . "order` WHERE order_status_id IN(" . implode(",", $implode) . ") AND DATE(date_added) = DATE(NOW()) GROUP BY HOUR(date_added) ORDER BY date_added ASC");\r\n\t\t\t}\r\n\t\t\t  ]]></add>\r\n\t\t</operation>\r\n\t\t<operation error="skip">\r\n\t\t\t<search ><![CDATA[\r\n\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "order` WHERE order_status_id IN(" . implode(",", $implode) . ") AND DATE(date_added) >= DATE(\'" . $this->db->escape(date(\'Y-m-d\', $date_start)) . "\') GROUP BY DAYNAME(date_added)");\r\n\t\t\t]]></search>\r\n\t\t\t<add position="replace"><![CDATA[ \t\t\t \r\n\t\t\t$userac = $this->registry->get(\'user\');\t\t\r\n\t\t\tif($userac->user_group_name==\'Store admin\') {\r\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "order` WHERE order_status_id IN(" . implode(",", $implode) . ") AND DATE(date_added) >= DATE(\'" . $this->db->escape(date(\'Y-m-d\', $date_start)) . "\') AND store_id=".$userac->store_id." GROUP BY DAYNAME(date_added)");\r\n\r\n\t\t\t\t\r\n\t\t\t}else{\r\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "order` WHERE order_status_id IN(" . implode(",", $implode) . ") AND DATE(date_added) >= DATE(\'" . $this->db->escape(date(\'Y-m-d\', $date_start)) . "\') GROUP BY DAYNAME(date_added)");\r\n\t\t\t}\r\n\t\t\t  ]]></add>\r\n\t\t</operation>\r\n\t\t<operation error="skip">\r\n\t\t\t<search ><![CDATA[\r\n\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "order` WHERE order_status_id IN(" . implode(",", $implode) . ") AND DATE(date_added) >= \'" . $this->db->escape(date(\'Y\') . \'-\' . date(\'m\') . \'-1\') . "\' GROUP BY DATE(date_added)");\r\n\t\t\t]]></search>\r\n\t\t\t<add position="replace"><![CDATA[ \t\t\t \r\n\t\t\t$userac = $this->registry->get(\'user\');\t\t\r\n\t\t\tif($userac->user_group_name==\'Store admin\') {\r\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "order` WHERE order_status_id IN(" . implode(",", $implode) . ") AND DATE(date_added) >= \'" . $this->db->escape(date(\'Y\') . \'-\' . date(\'m\') . \'-1\') . "\' AND store_id=".$userac->store_id." GROUP BY DATE(date_added)");\t\t\t\t\r\n\t\t\t}else{\r\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "order` WHERE order_status_id IN(" . implode(",", $implode) . ") AND DATE(date_added) >= \'" . $this->db->escape(date(\'Y\') . \'-\' . date(\'m\') . \'-1\') . "\' GROUP BY DATE(date_added)");\r\n\t\t\t}\r\n\t\t\t  ]]></add>\r\n\t\t</operation>\r\n\t\t<operation error="skip">\r\n\t\t\t<search ><![CDATA[\r\n\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "order` WHERE order_status_id IN(" . implode(",", $implode) . ") AND YEAR(date_added) = YEAR(NOW()) GROUP BY MONTH(date_added)");\r\n\t\t\t]]></search>\r\n\t\t\t<add position="replace"><![CDATA[ \t\t\t \r\n\t\t\t$userac = $this->registry->get(\'user\');\t\t\r\n\t\t\tif($userac->user_group_name==\'Store admin\') {\r\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "order` WHERE order_status_id IN(" . implode(",", $implode) . ") AND YEAR(date_added) = YEAR(NOW()) AND store_id=".$userac->store_id." GROUP BY MONTH(date_added)");\t\t\t\t\r\n\t\t\t}else{\r\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "order` WHERE order_status_id IN(" . implode(",", $implode) . ") AND YEAR(date_added) = YEAR(NOW()) GROUP BY MONTH(date_added)");\r\n\t\t\t}\r\n\t\t\t  ]]></add>\r\n\t\t</operation>\t\t\r\n\t</file>\r\n\t<!-- Customer report -->\r\n\t<file path="admin/model/report/customer.php">\t\t\r\n\t\t<operation error="skip">\r\n\t\t\t<search ><![CDATA[\r\n\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, HOUR(date_added) AS hour FROM `" . DB_PREFIX . "customer` WHERE DATE(date_added) = DATE(NOW()) GROUP BY HOUR(date_added) ORDER BY date_added ASC");\r\n\t\t\t]]></search>\r\n\t\t\t<add position="replace"><![CDATA[\t\t\t \r\n\t\t\t$userac = $this->registry->get(\'user\');\t\t\r\n\t\t\tif($userac->user_group_name==\'Store admin\') {\t\t\t\t\r\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, HOUR(c.date_added) AS hour FROM `" . DB_PREFIX . "customer` c \r\n\t\t\t\tINNER JOIN `" . DB_PREFIX . "order` o ON o.customer_id = c.customer_id  \t\t\t\t\r\n\t\t\t\tWHERE DATE(c.date_added) = DATE(NOW()) AND o.store_id=".$userac->store_id." GROUP BY HOUR(c.date_added) ORDER BY c.date_added ASC");\r\n\t\t\t} else {\r\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, HOUR(date_added) AS hour FROM `" . DB_PREFIX . "customer` WHERE DATE(date_added) = DATE(NOW()) GROUP BY HOUR(date_added) ORDER BY date_added ASC");\r\n\t\t\t}\r\n\t\t\t]]></add>\r\n\t\t</operation>\r\n\t\t<operation error="skip">\r\n\t\t\t<search ><![CDATA[\r\n\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "customer` WHERE DATE(date_added) >= DATE(\'" . $this->db->escape(date(\'Y-m-d\', $date_start)) . "\') GROUP BY DAYNAME(date_added)");\r\n\t\t\t]]></search>\r\n\t\t\t<add position="replace"><![CDATA[\t\t\t \r\n\t\t\t$userac = $this->registry->get(\'user\');\t\t\r\n\t\t\tif($userac->user_group_name==\'Store admin\') {\t\t\t\t\r\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, c.date_added FROM `" . DB_PREFIX . "customer` c\r\n\t\t\t\tINNER JOIN `" . DB_PREFIX . "order` o ON o.customer_id = c.customer_id\r\n\t\t\t\tWHERE DATE(c.date_added) >= DATE(\'" . $this->db->escape(date(\'Y-m-d\', $date_start)) . "\') AND o.store_id=".$userac->store_id." GROUP BY DAYNAME(c.date_added)");\r\n\t\t\t} else {\r\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "customer` WHERE DATE(date_added) >= DATE(\'" . $this->db->escape(date(\'Y-m-d\', $date_start)) . "\') GROUP BY DAYNAME(date_added)");\r\n\t\t\t}\r\n\t\t\t]]></add>\r\n\t\t</operation>\r\n\t\t<operation error="skip">\r\n\t\t\t<search ><![CDATA[\r\n\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "customer` WHERE DATE(date_added) >= \'" . $this->db->escape(date(\'Y\') . \'-\' . date(\'m\') . \'-1\') . "\' GROUP BY DATE(date_added)");\r\n\t\t\t]]></search>\r\n\t\t\t<add position="replace"><![CDATA[\t\t\t \r\n\t\t\t$userac = $this->registry->get(\'user\');\t\t\r\n\t\t\tif($userac->user_group_name==\'Store admin\') {\t\t\t\t\r\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, c.date_added FROM `" . DB_PREFIX . "customer` c\r\n\t\t\t\tINNER JOIN `" . DB_PREFIX . "order` o ON o.customer_id = c.customer_id\r\n\t\t\t\tWHERE o.store_id=".$userac->store_id." AND DATE(c.date_added) >= \'" . $this->db->escape(date(\'Y\') . \'-\' . date(\'m\') . \'-1\') . "\' GROUP BY DATE(c.date_added)");\r\n\t\t\t} else {\r\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "customer` WHERE DATE(date_added) >= \'" . $this->db->escape(date(\'Y\') . \'-\' . date(\'m\') . \'-1\') . "\' GROUP BY DATE(date_added)");\r\n\t\t\t}\r\n\t\t\t]]></add>\r\n\t\t</operation>\r\n\t\t<operation error="skip">\r\n\t\t\t<search ><![CDATA[\r\n\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "customer` WHERE YEAR(date_added) = YEAR(NOW()) GROUP BY MONTH(date_added)");\r\n\t\t\t]]></search>\r\n\t\t\t<add position="replace"><![CDATA[\t\t\t \r\n\t\t\t$userac = $this->registry->get(\'user\');\t\t\r\n\t\t\tif($userac->user_group_name==\'Store admin\') {\t\t\t\t\r\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, c.date_added FROM `" . DB_PREFIX . "customer` c\r\n\t\t\t\tINNER JOIN `" . DB_PREFIX . "order` o ON o.customer_id = c.customer_id\r\n\t\t\t\tWHERE YEAR(c.date_added) = YEAR(NOW()) AND o.store_id=".$userac->store_id." GROUP BY MONTH(c.date_added)");\r\n\t\t\t} else {\r\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total, date_added FROM `" . DB_PREFIX . "customer` WHERE YEAR(date_added) = YEAR(NOW()) GROUP BY MONTH(date_added)");\r\n\t\t\t}\r\n\t\t\t]]></add>\r\n\t\t</operation>\r\n\t\t<operation error="skip">\r\n\t\t\t<search ><![CDATA[\r\n\t\t\tif (!empty($data[\'filter_order_status_id\'])) {\r\n\t\t\t]]></search>\r\n\t\t\t<add position="before"><![CDATA[\t\t\t \r\n\t\t\t$userac = $this->registry->get(\'user\');\t\t\r\n\t\t\tif($userac->user_group_name==\'Store admin\') {\t\t\t\t\r\n\t\t\t\t$sql .= " AND o.store_id=".$userac->store_id;\r\n\t\t\t}\r\n\t\t\t]]></add>\r\n\t\t</operation>\r\n\t</file>\t\r\n\t<!-- Manage user -->\r\n\t<file path="admin/view/template/user/user_form.twig">\t\r\n\t\t<operation error="skip"> \r\n\t\t\t<search index="0"><![CDATA[<div class="form-group">]]></search>\r\n\t\t\t<add position="replace"><![CDATA[\r\n\t\t\t\t{% if user_group_name==\'Store admin\'%}\r\n\t\t\t\t\t<div class="form-group" style="display:none;">\r\n\t\t\t\t{% else %}\r\n\t\t\t\t\t<div class="form-group">\r\n\t\t\t\t{% endif %}\r\n\t\t\t]]>\r\n\t\t\t</add>\t\t  \r\n\t\t</operation>\r\n\t\t<operation error="skip"> \r\n\t\t\t<search index="0"><![CDATA[<option value="{{ user_group.user_group_id }}">{{ user_group.name }}</option>]]></search>\r\n\t\t\t<add position="replace"><![CDATA[\r\n\t\t\t\t{% if user_group_name==\'Store admin\'%}\r\n\t\t\t\t\t{% if user_group.name==\'Store admin\' %}\r\n\t\t\t\t\t\t<option value="{{ user_group.user_group_id }}" selected="selected">{{ user_group.name }}</option>\r\n\t\t\t\t\t{% endif %}\t\r\n\t\t\t\t{% else %}\r\n\t\t\t\t\t<option value="{{ user_group.user_group_id }}">{{ user_group.name }}</option>\r\n\t\t\t\t{% endif %}\r\n\t\t\t]]>\r\n\t\t\t</add>\t\t  \r\n\t\t</operation>\r\n\t\t<operation error="skip"> \r\n\t\t\t<search><![CDATA[<label class="col-sm-2 control-label" for="input-user-group">{{entry_store}}</label>]]></search>\r\n\t\t\t<add position="replace"><![CDATA[\r\n\t\t\t\t{% if user_group_name==\'Store admin\'%}\r\n\t\t\t\t\t<label style="display:none;" class="col-sm-2 control-label" for="input-user-group">{{entry_store}}</label>\t\r\n\t\t\t\t{% else %}\r\n\t\t\t\t\t<label class="col-sm-2 control-label" for="input-user-group">{{entry_store}}</label>\r\n\t\t\t\t{% endif %}\r\n\t\t\t]]>\r\n\t\t\t</add>\t\t  \r\n\t\t</operation>\r\n\t\t<operation error="skip"> \r\n\t\t\t<search index="2"><![CDATA[<div class="col-sm-10">]]></search>\r\n\t\t\t<add position="replace"><![CDATA[\r\n\t\t\t\t{% if user_group_name==\'Store admin\'%}\r\n\t\t\t\t\t<div style="display:none;" class="col-sm-10">\r\n\t\t\t\t{% else %}\r\n\t\t\t\t\t<div class="col-sm-10">\r\n\t\t\t\t{% endif %}\r\n\t\t\t]]>\r\n\t\t\t</add>\t\t  \r\n\t\t</operation>\t\t\r\n\t</file>\r\n</modification>\n', '0', '2020-08-07 17:51:29');
INSERT INTO `oc_modification` (`modification_id`, `extension_install_id`, `name`, `code`, `author`, `version`, `link`, `xml`, `status`, `date_added`) VALUES ('30', '0', 'Architect #46 - Admin store', 'architect_arc5f3d179816f87', 'magzhan9292', '3.0.0.0', '...', '<modification>\r\n    <name>Architect #46 - Admin store</name>\r\n    <version>3.0.0.0</version>\r\n    <link>...</link>\r\n    <author>magzhan9292</author>\r\n    <code>arc5f3d179816f87</code>\r\n\r\n\t<file path="admin/language/en-gb/user/user.php">\t\r\n\t\t<operation error="skip"> \r\n\t\t\t<search><![CDATA[$_[\'entry_user_group\']      = \'User Group\';]]></search>\r\n\t\t  <add position="after"><![CDATA[$_[\'entry_store\'] \t\t= \'Store\';]]>\r\n\t\t  </add>\t\t  \r\n\t\t</operation>\r\n\t</file>\t\t\t\r\n\t<file path="system/library/cart/user.php">\r\n\t\t<operation error="skip"> \r\n\t\t\t<search ><![CDATA[$this->user_group_id = $user_query->row[\'user_group_id\'];]]></search>\r\n\t\t  <add position="after"><![CDATA[\r\n\t\t\tif(isset($user_query->row[\'store_id\'])&&strlen($user_query->row[\'store_id\'])>0){\r\n\t\t\t\t$this->store_id = $user_query->row[\'store_id\'];\r\n\t\t\t}\r\n\t\t\tif(isset($user_query->row[\'name\'])&&strlen($user_query->row[\'name\'])>0){\r\n\t\t\t\t$this->user_group_name = $user_query->row[\'name\'];\r\n\t\t\t}\r\n\t\t\t]]>\r\n\t\t  </add>\t\t  \r\n\t\t</operation>\r\n\t\t<operation error="skip"> \r\n\t\t\t<search ><![CDATA[$user_query = $this->db->query("SELECT * FROM " . DB_PREFIX . "user WHERE user_id = \'" . (int)$this->session->data[\'user_id\'] . "\' AND status = \'1\'");]]></search>\r\n\t\t\t<add position="replace"><![CDATA[\r\n\t\t\t\t$user_query = $this->db->query("SELECT u.*,ug.name FROM " . DB_PREFIX . "user u INNER JOIN " . DB_PREFIX . "user_group ug ON u.user_group_id = ug.user_group_id WHERE user_id = \'" . (int)$this->session->data[\'user_id\'] . "\' AND status = \'1\'");\r\n\t\t\t\t]]>\r\n\t\t\t</add>\t\t  \r\n\t\t</operation>\r\n\t\t<operation error="skip"> \r\n\t\t\t<search ><![CDATA[$user_query = $this->db->query("SELECT * FROM " . DB_PREFIX . "user WHERE username = \'" . $this->db->escape($username) . "\' AND (password = SHA1(CONCAT(salt, SHA1(CONCAT(salt, SHA1(\'" . $this->db->escape($password) . "\'))))) OR password = \'" . $this->db->escape(md5($password)) . "\') AND status = \'1\'");]]></search>\r\n\t\t\t<add position="replace"><![CDATA[\t\t\t\t\r\n\t\t\t\t$user_query = $this->db->query("SELECT u.*,ug.name FROM " . DB_PREFIX . "user u INNER JOIN " . DB_PREFIX . "user_group ug ON u.user_group_id = ug.user_group_id WHERE (email = \'" . $this->db->escape($username) . "\' OR username = \'" . $this->db->escape($username) . "\') AND (password = SHA1(CONCAT(salt, SHA1(CONCAT(salt, SHA1(\'" . $this->db->escape($password) . "\'))))) OR password = \'" . $this->db->escape(md5($password)) . "\') AND status = \'1\'");\r\n\t\t\t\t]]>\r\n\t\t\t</add>\r\n\t\t</operation>\r\n\t</file>\t\t\r\n<!-- Filter product -->\t\r\n\t\r\n\t<!-- Filter order -->\t\r\n\t<file path="admin/model/sale/order.php">\r\n\t\t<operation error="skip">\r\n\t\t\t<search><![CDATA[\r\n\t\t\tif (!empty($data[\'filter_order_id\'])) {\r\n\t\t\t]]></search>\r\n\t\t\t<add position="before"><![CDATA[\r\n\t\t\t$userac = $this->registry->get(\'user\');\t\r\n\t\t\tif($userac->user_group_name==\'Store admin\') {\r\n\t\t\t\t$sql .= " AND store_id=".$userac->store_id;\t\t\t\t\r\n\t\t\t}\t\t\t\r\n\t\t  ]]></add>\r\n\t\t</operation>\r\n\t\t<operation error="skip">\r\n\t\t\t<search><![CDATA[\r\n\t\t\t\tpublic function getOrder($order_id) {\r\n\t\t\t]]></search>\r\n\t\t\t<add position="before"><![CDATA[\r\n\t\t\tpublic function checkOrderForStore($order_id){\r\n\t\t\t\t$userac = $this->registry->get(\'user\');\t\t\r\n\t\t\t\tif($userac->user_group_name==\'Store admin\') {\t\t\t\t\r\n\t\t\t\t\t$sql = "SELECT count(order_id) as total FROM " . DB_PREFIX . "order o WHERE o.order_id=$order_id AND o.store_id=".$userac->store_id;\r\n\t\t\t\t\t$result = $this->db->query($sql)->row;\r\n\t\t\t\t\tif($result[\'total\']==0){\r\n\t\t\t\t\t\treturn false;\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\treturn true;\r\n\t\t\t\t\t}\t\t\t\r\n\t\t\t\t}else{\r\n\t\t\t\t\treturn true;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t]]></add>\r\n\t\t</operation>\t\t\r\n\t</file>\r\n\t<!-- Add/Edit Order -->\r\n\t<file path="admin/language/en-gb/sale/order.php">\r\n\t\t<operation error="skip">\r\n\t\t\t<search><![CDATA[\r\n\t\t\t\t// Error\r\n\t\t\t]]></search>\r\n\t\t\t<add position="after"><![CDATA[\r\n\t\t\t$_[\'error_not_found\']        = \'Warning: Order not found!\';\r\n\t\t\t]]></add>\r\n\t\t</operation>\r\n\t</file>\t\r\n\t<file path="admin/controller/sale/order.php">\t\t\r\n\t\t<operation error="skip">\r\n\t\t\t<search ><![CDATA[\r\n\t\t\t$order_info = $this->model_sale_order->getOrder($this->request->get[\'order_id\']);\r\n\t\t\t]]></search>\r\n\t\t\t<add position="before"><![CDATA[ \r\n\t\t\tif(!$this->model_sale_order->checkOrderForStore($this->request->get[\'order_id\'])){\r\n\t\t\t\t$this->session->data[\'error\'] = $this->language->get(\'error_not_found\');\r\n\t\t\t\t$this->response->redirect($this->url->link(\'sale/order\', \'user_token=\' . $this->session->data[\'user_token\'] . $url, true));\r\n\t\t\t}]]></add>\r\n\t\t</operation>\r\n\t\t<operation error="skip">\r\n\t\t\t<search ><![CDATA[\r\n\t\t\t$data[\'error_warning\'] = \'\';\r\n\t\t\t]]></search>\r\n\t\t\t<add position="replace"><![CDATA[\r\n\t\t\tif (isset($this->session->data[\'error\'])) {\r\n\t\t\t\t$data[\'error_warning\'] = $this->session->data[\'error\'];\r\n\r\n\t\t\t\tunset($this->session->data[\'error\']);\r\n\t\t\t} else {\r\n\t\t\t\t$data[\'error_warning\'] = \'\';\r\n\t\t\t}\r\n\t\t]]></add>\r\n\t\t</operation>\t\r\n\t\t<operation error="skip">\r\n\t\t\t<search><![CDATA[\r\n\t\t\tpublic function getForm() {\r\n\t\t\t]]></search>\r\n\t\t\t<add position="after"><![CDATA[\r\n\t\t\t\t$userac = $this->registry->get(\'user\');\t\t\r\n\t\t\t\t$data[\'user_group_name\'] = $userac->user_group_name;\r\n\t\t\t\t$data[\'user_store_id\'] = $userac->store_id;\r\n\t\t\t]]></add>\r\n\t\t</operation>\r\n\t</file>\r\n\t<file path="admin/view/template/sale/order_form.twig">\r\n\t\t<operation error="skip">\r\n\t\t\t<search><![CDATA[\t\t\t\r\n\t\t\t<label class="col-sm-2 control-label" for="input-store">{{ entry_store }}</label>\r\n\t\t\t]]></search>\r\n\t\t\t<add position="before"><![CDATA[\r\n\t\t\t{% if user_group_name==\'Store admin\'%}\r\n\t\t\t\t\t<div style="display:none">\r\n\t\t\t{% endif %}\t\t\t\r\n\t\t  ]]></add>\r\n\t\t</operation>\r\n\t\t<operation error="skip">\r\n\t\t\t<search><![CDATA[\r\n\t\t\t<label class="col-sm-2 control-label" for="input-currency">{{ entry_currency }}</label>\r\n\t\t\t]]></search>\r\n\t\t\t<add position="before"><![CDATA[\r\n\t\t\t{% if user_group_name==\'Store admin\'%}\r\n\t\t\t\t\t</div>\r\n\t\t\t{% endif %}\r\n\t\t  ]]></add>\r\n\t\t</operation>\r\n\t</file>\t\r\n\t\r\n\t<!-- Customer filter -->\r\n\t<file path="admin/model/customer/customer.php">\t\t\r\n\t\t<operation error="skip">\r\n\t\t\t<search ><![CDATA[\r\n\t\t\tif (isset($data[\'filter_status\']) && $data[\'filter_status\'] !== \'\') {\r\n\t\t\t]]></search>\r\n\t\t\t<add position="before"><![CDATA[ \t\t\t\r\n\t\t\t$userac = $this->registry->get(\'user\');\t\t\r\n\t\t\t$data[\'user_group_name\'] = $userac->user_group_name;\r\n\t\t\tif($data[\'user_group_name\']==\'Store admin\') {\r\n\t\t\t\t$filter_store = $userac->store_id;\t\t\t\r\n\t\t\t\t$implode[] = "store_id = ".(int)$filter_store;\r\n\t\t\t}]]></add>\r\n\t\t</operation>\t\t\r\n\t\t<operation error="skip">\r\n\t\t\t<search ><![CDATA[\r\n\t\t\t$this->db->query("INSERT INTO " . DB_PREFIX . "customer SET customer_group_id = \'" . (int)$data[\'customer_group_id\'] . "\', firstname = \'" . $this->db->escape($data[\'firstname\']) . "\', lastname = \'" . $this->db->escape($data[\'lastname\']) . "\', email = \'" . $this->db->escape($data[\'email\']) . "\', telephone = \'" . $this->db->escape($data[\'telephone\']) . "\', custom_field = \'" . $this->db->escape(isset($data[\'custom_field\']) ? json_encode($data[\'custom_field\']) : json_encode(array())) . "\', newsletter = \'" . (int)$data[\'newsletter\'] . "\', salt = \'" . $this->db->escape($salt = token(9)) . "\', password = \'" . $this->db->escape(sha1($salt . sha1($salt . sha1($data[\'password\'])))) . "\', status = \'" . (int)$data[\'status\'] . "\', safe = \'" . (int)$data[\'safe\'] . "\', date_added = NOW()");\r\n\t\t\t]]></search>\r\n\t\t\t<add position="replace"><![CDATA[ \r\n\t\t\t$userac = $this->registry->get(\'user\');\t\t\r\n\t\t\t$data[\'user_group_name\'] = $userac->user_group_name;\r\n\t\t\tif($data[\'user_group_name\']==\'Store admin\') {\r\n\t\t\t\t$user_store_id = $userac->store_id;\t\t\t\r\n\t\t\t\t$this->db->query("INSERT INTO " . DB_PREFIX . "customer SET customer_group_id = \'" . (int)$data[\'customer_group_id\'] . "\', firstname = \'" . $this->db->escape($data[\'firstname\']) . "\', lastname = \'" . $this->db->escape($data[\'lastname\']) . "\', email = \'" . $this->db->escape($data[\'email\']) . "\', telephone = \'" . $this->db->escape($data[\'telephone\']) . "\', custom_field = \'" . $this->db->escape(isset($data[\'custom_field\']) ? json_encode($data[\'custom_field\']) : json_encode(array())) . "\', newsletter = \'" . (int)$data[\'newsletter\'] . "\', salt = \'" . $this->db->escape($salt = token(9)) . "\', password = \'" . $this->db->escape(sha1($salt . sha1($salt . sha1($data[\'password\'])))) . "\', status = \'" . (int)$data[\'status\'] . "\', safe = \'" . (int)$data[\'safe\'] . "\', date_added = NOW(), store_id=$user_store_id");\r\n\t\t\t}else{\r\n\t\t\t\t$this->db->query("INSERT INTO " . DB_PREFIX . "customer SET customer_group_id = \'" . (int)$data[\'customer_group_id\'] . "\', firstname = \'" . $this->db->escape($data[\'firstname\']) . "\', lastname = \'" . $this->db->escape($data[\'lastname\']) . "\', email = \'" . $this->db->escape($data[\'email\']) . "\', telephone = \'" . $this->db->escape($data[\'telephone\']) . "\', custom_field = \'" . $this->db->escape(isset($data[\'custom_field\']) ? json_encode($data[\'custom_field\']) : json_encode(array())) . "\', newsletter = \'" . (int)$data[\'newsletter\'] . "\', salt = \'" . $this->db->escape($salt = token(9)) . "\', password = \'" . $this->db->escape(sha1($salt . sha1($salt . sha1($data[\'password\'])))) . "\', status = \'" . (int)$data[\'status\'] . "\', safe = \'" . (int)$data[\'safe\'] . "\', date_added = NOW()");\r\n\t\t\t}\r\n\t\t\t]]></add>\r\n\t\t</operation>\r\n\t\t<operation error="skip">\r\n\t\t\t<search><![CDATA[\r\n\t\t\t\tpublic function getCustomer($customer_id) {\r\n\t\t\t]]></search>\r\n\t\t\t<add position="before"><![CDATA[\r\n\t\t\tpublic function checkCustomerForStore($customer_id){\r\n\t\t\t\t$userac = $this->registry->get(\'user\');\t\t\r\n\t\t\t\tif($userac->user_group_name==\'Store admin\') {\t\t\t\t\r\n\t\t\t\t\t$sql = "SELECT count(customer_id) as total FROM " . DB_PREFIX . "customer c WHERE c.customer_id=$customer_id AND c.store_id=".$userac->store_id;\r\n\t\t\t\t\t$result = $this->db->query($sql)->row;\r\n\t\t\t\t\tif($result[\'total\']==0){\r\n\t\t\t\t\t\treturn false;\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\treturn true;\r\n\t\t\t\t\t}\t\t\t\r\n\t\t\t\t}else{\r\n\t\t\t\t\treturn true;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t]]></add>\r\n\t\t</operation>\t\t\r\n\t</file>\r\n\t<!-- Add/Edit Customer -->\r\n\t<file path="admin/language/en-gb/customer/customer.php">\r\n\t\t<operation error="skip">\r\n\t\t\t<search><![CDATA[\r\n\t\t\t\t// Error\r\n\t\t\t]]></search>\r\n\t\t\t<add position="after"><![CDATA[\r\n\t\t\t$_[\'error_not_found\']        = \'Warning: Customer not found!\';\r\n\t\t\t]]></add>\r\n\t\t</operation>\r\n\t</file>\t\r\n\t<file path="admin/controller/customer/customer.php">\t\t\r\n\t\t<operation error="skip">\r\n\t\t\t<search ><![CDATA[\r\n\t\t\t$customer_info = $this->model_customer_customer->getCustomer($this->request->get[\'customer_id\']);\r\n\t\t\t]]></search>\r\n\t\t\t<add position="before"><![CDATA[ \r\n\t\t\tif(!$this->model_customer_customer->checkCustomerForStore($this->request->get[\'customer_id\'])){\r\n\t\t\t\t$this->session->data[\'error\'] = $this->language->get(\'error_not_found\');\r\n\t\t\t\t$this->response->redirect($this->url->link(\'customer/customer\', \'user_token=\' . $this->session->data[\'user_token\'] . $url, true));\r\n\t\t\t}]]></add>\r\n\t\t</operation>\r\n\t\t<operation error="skip">\r\n\t\t\t<search ><![CDATA[\r\n\t\t\t$data[\'error_warning\'] = \'\';\r\n\t\t\t]]></search>\r\n\t\t\t<add position="replace"><![CDATA[\r\n\t\t\tif (isset($this->session->data[\'error\'])) {\r\n\t\t\t\t$data[\'error_warning\'] = $this->session->data[\'error\'];\r\n\r\n\t\t\t\tunset($this->session->data[\'error\']);\r\n\t\t\t} else {\r\n\t\t\t\t$data[\'error_warning\'] = \'\';\r\n\t\t\t}\r\n\t\t]]></add>\r\n\t\t</operation>\t\t\t\r\n\t</file>\r\n\t<!-- File manager -->\t\r\n\t<file path="admin/controller/common/filemanager.php">        \r\n\t\t<operation error="skip">\r\n\t\t\t<search ><![CDATA[$directory = DIR_IMAGE . \'catalog\';]]></search>\r\n\t\t\t<add position="replace"><![CDATA[ \r\n\t\t\t$userac = $this->registry->get(\'user\');\t\t\r\n\t\t\t$user_group_name = $userac->user_group_name;\r\n\t\t\t$user_store_id = $userac->store_id;\r\n\t\t\tif($user_group_name==\'Store admin\'){\r\n\t\t\t\t$directory = DIR_IMAGE . \'catalog/store_\'.$user_store_id;\r\n\t\t\t\t$base_directory = DIR_IMAGE . \'catalog/store_\'.$user_store_id;\r\n\t\t\t}else{\r\n\t\t\t\t$directory = DIR_IMAGE . \'catalog\';\r\n\t\t\t\t$base_directory = DIR_IMAGE . \'catalog\';\r\n\t\t\t}\r\n\t\t\t]]></add>\r\n\t\t</operation>\r\n\t\t<operation error="skip">\r\n\t\t\t<search ><![CDATA[$directory = rtrim(DIR_IMAGE . \'catalog/\' . $this->request->get[\'directory\'], \'/\');]]></search>\r\n\t\t\t<add position="replace"><![CDATA[ \r\n\t\t\t$userac = $this->registry->get(\'user\');\t\t\r\n\t\t\t$user_group_name = $userac->user_group_name;\r\n\t\t\t$user_store_id = $userac->store_id;\r\n\t\t\tif($user_group_name==\'Store admin\'){\t\t\t\t\r\n\t\t\t\t$base_directory = DIR_IMAGE . \'catalog/store_\'.$user_store_id;\r\n\t\t\t}else{\r\n\t\t\t\t$base_directory = DIR_IMAGE . \'catalog\';\t\t\t\r\n\t\t\t}\r\n\t\t\t$directory = rtrim(DIR_IMAGE . \'catalog/\' . $this->request->get[\'directory\'], \'/\');\r\n\t\t\t]]></add>\r\n\t\t</operation>\r\n\t\t<operation error="skip">\r\n\t\t\t<search ><![CDATA[if (!is_dir($directory) || substr(str_replace(\'\\\\\', \'/\', realpath($directory)), 0, strlen(DIR_IMAGE . \'catalog\')) != str_replace(\'\\\\\', \'/\', DIR_IMAGE . \'catalog\')) {]]></search>\r\n\t\t\t<add position="replace"><![CDATA[\r\n\t\t\t\tif (!is_dir($directory) || substr(str_replace(\'\\\\\', \'/\', realpath($directory)), 0, strlen($base_directory)) != $base_directory) {\r\n\t\t\t]]></add>\r\n\t\t</operation>\r\n\t\t<operation error="skip">\r\n\t\t\t<search ><![CDATA[if (substr(str_replace(\'\\\\\', \'/\', realpath($directory) . \'/\' . $filter_name), 0, strlen(DIR_IMAGE . \'catalog\')) == str_replace(\'\\\\\', \'/\', DIR_IMAGE . \'catalog\')) {]]></search>\r\n\t\t\t<add position="replace"><![CDATA[\r\n\t\t\t\tif (substr(str_replace(\'\\\\\', \'/\', realpath($directory) . \'/\' . $filter_name), 0, strlen($base_directory)) == $base_directory) {\r\n\t\t\t]]></add>\r\n\t\t</operation>\r\n\t\t<operation error="skip">\r\n\t\t\t<search ><![CDATA[public function index() {]]></search>\r\n\t\t\t<add position="after"><![CDATA[\r\n\t\t\t$userac = $this->registry->get(\'user\');\t\t\r\n\t\t\t$user_group_name = $userac->user_group_name;\r\n\t\t\t$user_store_id = $userac->store_id;\r\n\t\t\tif($user_group_name==\'Store admin\'){\r\n\t\t\t\t$directory = DIR_IMAGE . \'catalog/store_\'.$user_store_id;\r\n\t\t\t\t$base_directory = DIR_IMAGE . \'catalog/store_\'.$user_store_id;\r\n\t\t\t}else{\r\n\t\t\t\t$directory = DIR_IMAGE . \'catalog\';\r\n\t\t\t\t$base_directory = DIR_IMAGE . \'catalog\';\r\n\t\t\t}\r\n\t\t]]></add>\r\n\t\t</operation>\r\n\t\t<operation error="skip">\r\n\t\t\t<search ><![CDATA[$data[\'directory\'] = \'\';]]></search>\r\n\t\t\t<add position="replace"><![CDATA[\r\n\t\t\t\t$userac = $this->registry->get(\'user\');\t\t\r\n\t\t\t\t$user_group_name = $userac->user_group_name;\r\n\t\t\t\t$user_store_id = $userac->store_id;\r\n\t\t\t\tif($user_group_name==\'Store admin\'){\r\n\t\t\t\t\t$data[\'directory\'] = \'store_\'.$user_store_id;\t\t\t\t\t\r\n\t\t\t\t}else{\r\n\t\t\t\t\t$data[\'directory\'] = \'\';\t\t\t\t\t\r\n\t\t\t\t}\r\n\t\t\t]]></add>\r\n\t\t</operation>\r\n\t</file>\t\r\n\t<file path="admin/model/setting/store.php">\r\n\t\t<operation error="skip"> \r\n\t\t\t<search ><![CDATA[$store_id = $this->db->getLastId();]]></search>\r\n\t\t\t<add position="after"><![CDATA[\t\r\n\t\t\t\t//Create store directory\r\n\t\t\t\t$directory = DIR_IMAGE . \'catalog\';\r\n\t\t\t\t$folder = \'store_\'.$store_id;\r\n\t\t\t\t@mkdir($directory . \'/\' . $folder, 0777);\r\n\t\t\t\t@chmod($directory . \'/\' . $folder, 0777);\r\n\t\t\t\t@touch($directory . \'/\' . $folder . \'/\' . \'index.html\');\r\n\t\t\t]]></add>\r\n\t\t</operation>\r\n\t</file>\r\n\t<!-- Modification conflict -->\t\r\n\t<file path="admin/controller/marketplace/modification.php">\t\r\n\t\t<operation error="skip"> \r\n\t\t\t<search><![CDATA[protected function getList() {]]></search>\r\n\t\t  <add position="after"><![CDATA[\r\n\t\t  $this->load->language(\'extension/modification_manager\');\t\t  \r\n\t\t  $data[\'conflict\'] = $this->url->link(\'extension/modification_manager\', \'user_token=\' . $this->session->data[\'user_token\'], true);\r\n\t\t  ]]>\r\n\t\t  </add>\t\t  \r\n\t\t</operation>\r\n\t</file>\r\n\t<file path="admin/view/template/marketplace/modification.twig">\t\r\n\t\t<operation error="skip"> \r\n\t\t\t<search><![CDATA[<button type="button" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" onclick="confirm(\'{{ text_confirm }}\') ? $(\'#form-modification\').submit() : false;"><i class="fa fa-trash-o"></i></button>]]></search>\r\n\t\t  <add position="after"><![CDATA[\r\n\t\t  {% if conflict!=\'\' %}\t\t  \r\n\t\t  <a href="{{ conflict }}" data-toggle="tooltip" title="{{button_conflict}}" class="btn btn-default"><i class="fa fa-exclamation-triangle"></i></a>\r\n\t\t  {% endif %}\r\n\t\t  ]]>\r\n\t\t  </add>\t\t  \r\n\t\t</operation>\r\n\t</file>\r\n\t<!-- Sale return -->\r\n\t<file path="admin/model/sale/return.php">\r\n\t\t<operation error="skip">\r\n\t\t\t<search><![CDATA[\t\t\t\r\n\t\t\t$sql = "SELECT *, CONCAT(r.firstname, \' \', r.lastname) AS customer, (SELECT rs.name FROM " . DB_PREFIX . "return_status rs WHERE rs.return_status_id = r.return_status_id AND rs.language_id = \'" . (int)$this->config->get(\'config_language_id\') . "\') AS return_status FROM `" . DB_PREFIX . "return` r";\r\n\t\t\t]]></search>\r\n\t\t\t<add position="replace"><![CDATA[\r\n\t\t\t\t$sql = "SELECT *, CONCAT(r.firstname, \' \', r.lastname) AS customer, (SELECT rs.name FROM " . DB_PREFIX . "return_status rs WHERE rs.return_status_id = r.return_status_id AND rs.language_id = \'" . (int)$this->config->get(\'config_language_id\') . "\') AS return_status FROM `" . DB_PREFIX . "return` r\t\t\t\t\r\n\t\t\t\tINNER JOIN " . DB_PREFIX . "order o ON o.order_id = r.order_id";\r\n\t\t\t]]></add>\r\n\t\t</operation>\r\n\t\t<operation error="skip">\r\n\t\t\t<search><![CDATA[\r\n\t\t\t$sort_data = array(\r\n\t\t\t]]></search>\r\n\t\t\t<add position="before"><![CDATA[\r\n\t\t\t\t$userac = $this->registry->get(\'user\');\t\t\r\n\t\t\t\t$user_group_name = $userac->user_group_name;\r\n\t\t\t\tif($user_group_name==\'Store admin\'){\r\n\t\t\t\t\t$sql .= " AND o.store_id=".$userac->store_id;\r\n\t\t\t\t}\r\n\t\t\t]]></add>\r\n\t\t</operation>\r\n\t</file>\t\r\n\t<!-- Dashboard -->\t\t\r\n\t<!-- Recent order -->\r\n\t<file path="admin/controller/extension/dashboard/recent.php">        \r\n\t\t<operation error="skip">\r\n\t\t\t<search ><![CDATA[\r\n\t\t\tpublic function dashboard() {\r\n\t\t\t]]></search>\r\n\t\t\t<add positi