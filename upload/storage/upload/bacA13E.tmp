ATA[&lt;label class=&quot;col-sm-2 control-label&quot; for=&quot;input-user-group&quot;&gt;{{entry_store}}&lt;/label&gt;]]&gt;&lt;/search&gt;\r\n\t\t\t&lt;add position=&quot;replace&quot;&gt;&lt;![CDATA[\r\n\t\t\t\t{% if user_group_name==\'Store admin\'%}\r\n\t\t\t\t\t&lt;label style=&quot;display:none;&quot; class=&quot;col-sm-2 control-label&quot; for=&quot;input-user-group&quot;&gt;{{entry_store}}&lt;/label&gt;\t\r\n\t\t\t\t{% else %}\r\n\t\t\t\t\t&lt;label class=&quot;col-sm-2 control-label&quot; for=&quot;input-user-group&quot;&gt;{{entry_store}}&lt;/label&gt;\r\n\t\t\t\t{% endif %}\r\n\t\t\t]]&gt;\r\n\t\t\t&lt;/add&gt;\t\t  \r\n\t\t&lt;/operation&gt;\r\n\t\t&lt;operation error=&quot;skip&quot;&gt; \r\n\t\t\t&lt;search index=&quot;2&quot;&gt;&lt;![CDATA[&lt;div class=&quot;col-sm-10&quot;&gt;]]&gt;&lt;/search&gt;\r\n\t\t\t&lt;add position=&quot;replace&quot;&gt;&lt;![CDATA[\r\n\t\t\t\t{% if user_group_name==\'Store admin\'%}\r\n\t\t\t\t\t&lt;div style=&quot;display:none;&quot; class=&quot;col-sm-10&quot;&gt;\r\n\t\t\t\t{% else %}\r\n\t\t\t\t\t&lt;div class=&quot;col-sm-10&quot;&gt;\r\n\t\t\t\t{% endif %}\r\n\t\t\t]]&gt;\r\n\t\t\t&lt;/add&gt;\t\t  \r\n\t\t&lt;/operation&gt;\t\t\r\n\t&lt;/file&gt;\r\n&lt;/modification&gt;', '&lt;?php\r\nclass {event_class} extends Controller\r\n{\r\n    /**\r\n     * @trigger  catalog/controller/commmon/footer/before\r\n     * @action   {event_path}/foo\r\n     * @order    1\r\n     */\r\n    public function foo(&amp;$route, &amp;$data)\r\n    {\r\n        // Your code here..\r\n    }\r\n\r\n    /**\r\n     * @trigger  catalog/view/common/footer/after\r\n     * @action   {event_path}/bar\r\n     * @order    2\r\n     */\r\n    public function bar(&amp;$route, &amp;$data, &amp;$output)\r\n    {\r\n        // Your code here..\r\n    }\r\n}', '{"customer_group":"0","customer_group_ids":[]}', '{"author":"magzhan9292","note":"","editor":{"controller":0,"model":0,"template":0,"modification":"1","event":0}}', '1', '2020-08-06 00:00:00', '0000-00-00 00:00:00', '2020-08-06 17:10:15', '2020-08-07 17:51:29');
INSERT INTO `oc_architect` (`architect_id`, `module_id`, `identifier`, `name`, `controller`, `model`, `template`, `modification`, `event`, `option`, `meta`, `status`, `publish`, `unpublish`, `created`, `updated`) VALUES ('3', '46', 'arc5f3d179816f87', 'Admin store', '&lt;?php\r\nclass {controller_class} extends Controller\r\n{\r\n    public function index($param = array())\r\n    {\r\n        $data = $this-&gt;language();\r\n\r\n        // Your code here..\r\n\r\n        return $this-&gt;load-&gt;view(\'{template_path}\', $data);\r\n    }\r\n\r\n    protected function language($data = array())\r\n    {\r\n        $_[\'heading\']  = \'Architect\';\r\n        $_[\'greeting\'] = \'Hello World\';\r\n\r\n        return array_merge($data, $_);\r\n    }\r\n}', '&lt;?php\r\nclass {model_class} extends Model\r\n{\r\n    public function get($param = array())\r\n    {\r\n        $data = array();\r\n\r\n        // Usage in controller\r\n        // $this-&gt;load-&gt;model(\'{model_path}\');\r\n        // $data = $this-&gt;{model_call}-&gt;get(array());\r\n\r\n        return $data;\r\n    }\r\n}', '&lt;div class=&quot;module architect arc-{module_id}&quot;&gt;\r\n    &lt;div class=&quot;module-heading&quot;&gt;\r\n        &lt;h3&gt;{{ heading }}&lt;/h3&gt;\r\n    &lt;/div&gt;\r\n    &lt;div class=&quot;module-body&quot;&gt;\r\n        {{ greeting }}\r\n    &lt;/div&gt;\r\n&lt;/div&gt;', '&lt;modification&gt;\r\n    &lt;name&gt;{ocmod_name}&lt;/name&gt;\r\n    &lt;version&gt;3.0.0.0&lt;/version&gt;\r\n    &lt;link&gt;...&lt;/link&gt;\r\n    &lt;author&gt;{author}&lt;/author&gt;\r\n    &lt;code&gt;{ocmod_code}&lt;/code&gt;\r\n\r\n\t&lt;file path=&quot;admin/language/en-gb/user/user.php&quot;&gt;\t\r\n\t\t&lt;operation error=&quot;skip&quot;&gt; \r\n\t\t\t&lt;search&gt;&lt;![CDATA[$_[\'entry_user_group\']      = \'User Group\';]]&gt;&lt;/search&gt;\r\n\t\t  &lt;add position=&quot;after&quot;&gt;&lt;![CDATA[$_[\'entry_store\'] \t\t= \'Store\';]]&gt;\r\n\t\t  &lt;/add&gt;\t\t  \r\n\t\t&lt;/operation&gt;\r\n\t&lt;/file&gt;\t\t\t\r\n\t&lt;file path=&quot;system/library/cart/user.php&quot;&gt;\r\n\t\t&lt;operation error=&quot;skip&quot;&gt; \r\n\t\t\t&lt;search &gt;&lt;![CDATA[$this-&gt;user_group_id = $user_query-&gt;row[\'user_group_id\'];]]&gt;&lt;/search&gt;\r\n\t\t  &lt;add position=&quot;after&quot;&gt;&lt;![CDATA[\r\n\t\t\tif(isset($user_query-&gt;row[\'store_id\'])&amp;&amp;strlen($user_query-&gt;row[\'store_id\'])&gt;0){\r\n\t\t\t\t$this-&gt;store_id = $user_query-&gt;row[\'store_id\'];\r\n\t\t\t}\r\n\t\t\tif(isset($user_query-&gt;row[\'name\'])&amp;&amp;strlen($user_query-&gt;row[\'name\'])&gt;0){\r\n\t\t\t\t$this-&gt;user_group_name = $user_query-&gt;row[\'name\'];\r\n\t\t\t}\r\n\t\t\t]]&gt;\r\n\t\t  &lt;/add&gt;\t\t  \r\n\t\t&lt;/operation&gt;\r\n\t\t&lt;operation error=&quot;skip&quot;&gt; \r\n\t\t\t&lt;search &gt;&lt;![CDATA[$user_query = $this-&gt;db-&gt;query(&quot;SELECT * FROM &quot; . DB_PREFIX . &quot;user WHERE user_id = \'&quot; . (int)$this-&gt;session-&gt;data[\'user_id\'] . &quot;\' AND status = \'1\'&quot;);]]&gt;&lt;/search&gt;\r\n\t\t\t&lt;add position=&quot;replace&quot;&gt;&lt;![CDATA[\r\n\t\t\t\t$user_query = $this-&gt;db-&gt;query(&quot;SELECT u.*,ug.name FROM &quot; . DB_PREFIX . &quot;user u INNER JOIN &quot; . DB_PREFIX . &quot;user_group ug ON u.user_group_id = ug.user_group_id WHERE user_id = \'&quot; . (int)$this-&gt;session-&gt;data[\'user_id\'] . &quot;\' AND status = \'1\'&quot;);\r\n\t\t\t\t]]&gt;\r\n\t\t\t&lt;/add&gt;\t\t  \r\n\t\t&lt;/operation&gt;\r\n\t\t&lt;operation error=&quot;skip&quot;&gt; \r\n\t\t\t&lt;search &gt;&lt;![CDATA[$user_query = $this-&gt;db-&gt;query(&quot;SELECT * FROM &quot; . DB_PREFIX . &quot;user WHERE username = \'&quot; . $this-&gt;db-&gt;escape($username) . &quot;\' AND (password = SHA1(CONCAT(salt, SHA1(CONCAT(salt, SHA1(\'&quot; . $this-&gt;db-&gt;escape($password) . &quot;\'))))) OR password = \'&quot; . $this-&gt;db-&gt;escape(md5($password)) . &quot;\') AND status = \'1\'&quot;);]]&gt;&lt;/search&gt;\r\n\t\t\t&lt;add position=&quot;replace&quot;&gt;&lt;![CDATA[\t\t\t\t\r\n\t\t\t\t$user_query = $this-&gt;db-&gt;query(&quot;SELECT u.*,ug.name FROM &quot; . DB_PREFIX . &quot;user u INNER JOIN &quot; . DB_PREFIX . &quot;user_group ug ON u.user_group_id = ug.user_group_id WHERE (email = \'&quot; . $this-&gt;db-&gt;escape($username) . &quot;\' OR username = \'&quot; . $this-&gt;db-&gt;escape($username) . &quot;\') AND (password = SHA1(CONCAT(salt, SHA1(CONCAT(salt, SHA1(\'&quot; . $this-&gt;db-&gt;escape($password) . &quot;\'))))) OR password = \'&quot; . $this-&gt;db-&gt;escape(md5($password)) . &quot;\') AND status = \'1\'&quot;);\r\n\t\t\t\t]]&gt;\r\n\t\t\t&lt;/add&gt;\r\n\t\t&lt;/operation&gt;\r\n\t&lt;/file&gt;\t\t\r\n&lt;!-- Filter product --&gt;\t\r\n\t\r\n\t&lt;!-- Filter order --&gt;\t\r\n\t&lt;file path=&quot;admin/model/sale/order.php&quot;&gt;\r\n\t\t&lt;operation error=&quot;skip&quot;&gt;\r\n\t\t\t&lt;search&gt;&lt;![CDATA[\r\n\t\t\tif (!empty($data[\'filter_order_id\'])) {\r\n\t\t\t]]&gt;&lt;/search&gt;\r\n\t\t\t&lt;add position=&quot;before&quot;&gt;&lt;![CDATA[\r\n\t\t\t$userac = $this-&gt;registry-&gt;get(\'user\');\t\r\n\t\t\tif($userac-&gt;user_group_name==\'Store admin\') {\r\n\t\t\t\t$sql .= &quot; AND store_id=&quot;.$userac-&gt;store_id;\t\t\t\t\r\n\t\t\t}\t\t\t\r\n\t\t  ]]&gt;&lt;/add&gt;\r\n\t\t&lt;/operation&gt;\r\n\t\t&lt;operation error=&quot;skip&quot;&gt;\r\n\t\t\t&lt;search&gt;&lt;![CDATA[\r\n\t\t\t\tpublic function getOrder($order_id) {\r\n\t\t\t]]&gt;&lt;/search&gt;\r\n\t\t\t&lt;add position=&quot;before&quot;&gt;&lt;![CDATA[\r\n\t\t\tpublic function checkOrderForStore($order_id){\r\n\t\t\t\t$userac = $this-&gt;registry-&gt;get(\'user\');\t\t\r\n\t\t\t\tif($userac-&gt;user_group_name==\'Store admin\') {\t\t\t\t\r\n\t\t\t\t\t$sql = &quot;SELECT count(order_id) as total FROM &quot; . DB_PREFIX . &quot;order o WHERE o.order_id=$order_id AND o.store_id=&quot;.$userac-&gt;store_id;\r\n\t\t\t\t\t$result = $this-&gt;db-&gt;query($sql)-&gt;row;\r\n\t\t\t\t\tif($result[\'total\']==0){\r\n\t\t\t\t\t\treturn false;\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\treturn true;\r\n\t\t\t\t\t}\t\t\t\r\n\t\t\t\t}else{\r\n\t\t\t\t\treturn true;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t]]&gt;&lt;/add&gt;\r\n\t\t&lt;/operation&gt;\t\t\r\n\t&lt;/file&gt;\r\n\t&lt;!-- Add/Edit Order --&gt;\r\n\t&lt;file path=&quot;admin/language/en-gb/sale/order.php&quot;&gt;\r\n\t\t&lt;operation error=&quot;skip&quot;&gt;\r\n\t\t\t&lt;search&gt;&lt;![CDATA[\r\n\t\t\t\t// Error\r\n\t\t\t]]&gt;&lt;/search&gt;\r\n\t\t\t&lt;add position=&quot;after&quot;&gt;&lt;![CDATA[\r\n\t\t\t$_[\'error_not_found\']        = \'Warning: Order not found!\';\r\n\t\t\t]]&gt;&lt;/add&gt;\r\n\t\t&lt;/operation&gt;\r\n\t&lt;/file&gt;\t\r\n\t&lt;file path=&quot;admin/controller/sale/order.php&quot;&gt;\t\t\r\n\t\t&lt;operation error=&quot;skip&quot;&gt;\r\n\t\t\t&lt;search &gt;&lt;![CDATA[\r\n\t\t\t$order_info = $this-&gt;model_sale_order-&gt;getOrder($this-&gt;request-&gt;get[\'order_id\']);\r\n\t\t\t]]&gt;&lt;/search&gt;\r\n\t\t\t&lt;add position=&quot;before&quot;&gt;&lt;![CDATA[ \r\n\t\t\tif(!$this-&gt;model_sale_order-&gt;checkOrderForStore($this-&gt;request-&gt;get[\'order_id\'])){\r\n\t\t\t\t$this-&gt;session-&gt;data[\'error\'] = $this-&gt;language-&gt;get(\'error_not_found\');\r\n\t\t\t\t$this-&gt;response-&gt;redirect($this-&gt;url-&gt;link(\'sale/order\', \'user_token=\' . $this-&gt;session-&gt;data[\'user_token\'] . $url, true));\r\n\t\t\t}]]&gt;&lt;/add&gt;\r\n\t\t&lt;/operation&gt;\r\n\t\t&lt;operation error=&quot;skip&quot;&gt;\r\n\t\t\t&lt;search &gt;&lt;![CDATA[\r\n\t\t\t$data[\'error_warning\'] = \'\';\r\n\t\t\t]]&gt;&lt;/search&gt;\r\n\t\t\t&lt;add position=&quot;replace&quot;&gt;&lt;![CDATA[\r\n\t\t\tif (isset($this-&gt;session-&gt;data[\'error\'])) {\r\n\t\t\t\t$data[\'error_warning\'] = $this-&gt;session-&gt;data[\'error\'];\r\n\r\n\t\t\t\tunset($this-&gt;session-&gt;data[\'error\']);\r\n\t\t\t} else {\r\n\t\t\t\t$data[\'error_warning\'] = \'\';\r\n\t\t\t}\r\n\t\t]]&gt;&lt;/add&gt;\r\n\t\t&lt;/operation&gt;\t\r\n\t\t&lt;operation error=&quot;skip&quot;&gt;\r\n\t\t\t&lt;search&gt;&lt;![CDATA[\r\n\t\t\tpublic function getForm() {\r\n\t\t\t]]&gt;&lt;/search&gt;\r\n\t\t\t&lt;add position=&quot;after&quot;&gt;&lt;![CDATA[\r\n\t\t\t\t$userac = $this-&gt;registry-&gt;get(\'user\');\t\t\r\n\t\t\t\t$data[\'user_group_name\'] = $userac-&gt;user_group_name;\r\n\t\t\t\t$data[\'user_store_id\'] = $userac-&gt;store_id;\r\n\t\t\t]]&gt;&lt;/add&gt;\r\n\t\t&lt;/operation&gt;\r\n\t&lt;/file&gt;\r\n\t&lt;file path=&quot;admin/view/template/sale/order_form.twig&quot;&gt;\r\n\t\t&lt;operation error=&quot;skip&quot;&gt;\r\n\t\t\t&lt;search&gt;&lt;![CDATA[\t\t\t\r\n\t\t\t&lt;label class=&quot;col-sm-2 control-label&quot; for=&quot;input-store&quot;&gt;{{ entry_store }}&lt;/label&gt;\r\n\t\t\t]]&gt;&lt;/search&gt;\r\n\t\t\t&lt;add position=&quot;before&quot;&gt;&lt;![CDATA[\r\n\t\t\t{% if user_group_name==\'Store admin\'%}\r\n\t\t\t\t\t&lt;div style=&quot;display:none&quot;&gt;\r\n\t\t\t{% endif %}\t\t\t\r\n\t\t  ]]&gt;&lt;/add&gt;\r\n\t\t&lt;/operation&gt;\r\n\t\t&lt;operation error=&quot;skip&quot;&gt;\r\n\t\t\t&lt;search&gt;&lt;![CDATA[\r\n\t\t\t&lt;label class=&quot;col-sm-2 control-label&quot; for=&quot;input-currency&quot;&gt;{{ entry_currency }}&lt;/label&gt;\r\n\t\t\t]]&gt;&lt;/search&gt;\r\n\t\t\t&lt;add position=&quot;before&quot;&gt;&lt;![CDATA[\r\n\t\t\t{% if user_group_name==\'Store admin\'%}\r\n\t\t\t\t\t&lt;/div&gt;\r\n\t\t\t{% endif %}\r\n\t\t  ]]&gt;&lt;/add&gt;\r\n\t\t&lt;/operation&gt;\r\n\t&lt;/file&gt;\t\r\n\t\r\n\t&lt;!-- Customer filter --&gt;\r\n\t&lt;file path=&quot;admin/model/customer/customer.php&quot;&gt;\t\t\r\n\t\t&lt;operation error=&quot;skip&quot;&gt;\r\n\t\t\t&lt;search &gt;&lt;![CDATA[\r\n\t\t\tif (isset($data[\'filter_status\']) &amp;&amp; $data[\'filter_status\'] !== \'\') {\r\n\t\t\t]]&gt;&lt;/search&gt;\r\n\t\t\t&lt;add position=&quot;before&quot;&gt;&lt;![CDATA[ \t\t\t\r\n\t\t\t$userac = $this-&gt;registry-&gt;get(\'user\');\t\t\r\n\t\t\t$data[\'user_group_name\'] = $userac-&gt;user_group_name;\r\n\t\t\tif($data[\'user_group_name\']==\'Store admin\') {\r\n\t\t\t\t$filter_store = $userac-&gt;store_id;\t\t\t\r\n\t\t\t\t$implode[] = &quot;store_id = &quot;.(int)$filter_store;\r\n\t\t\t}]]&gt;&lt;/add&gt;\r\n\t\t&lt;/operation&gt;\t\t\r\n\t\t&lt;operation error=&quot;skip&quot;&gt;\r\n\t\t\t&lt;search &gt;&lt;![CDATA[\r\n\t\t\t$this-&gt;db-&gt;query(&quot;INSERT INTO &quot; . DB_PREFIX . &quot;customer SET customer_group_id = \'&quot; . (int)$data[\'customer_group_id\'] . &quot;\', firstname = \'&quot; . $this-&gt;db-&gt;escape($data[\'firstname\']) . &quot;\', lastname = \'&quot; . $this-&gt;db-&gt;escape($data[\'lastname\']) . &quot;\', email = \'&quot; . $this-&gt;db-&gt;escape($data[\'email\']) . &quot;\', telephone = \'&quot; . $this-&gt;db-&gt;escape($data[\'telephone\']) . &quot;\', custom_field = \'&quot; . $this-&gt;db-&gt;escape(isset($data[\'custom_field\']) ? json_encode($data[\'custom_field\']) : json_encode(array())) . &quot;\', newsletter = \'&quot; . (int)$data[\'newsletter\'] . &quot;\', salt = \'&quot; . $this-&gt;db-&gt;escape($salt = token(9)) . &quot;\', password = \'&quot; . $this-&gt;db-&gt;escape(sha1($salt . sha1($salt . sha1($data[\'password\'])))) . &quot;\', status = \'&quot; . (int)$data[\'status\'] . &quot;\', safe = \'&quot; . (int)$data[\'safe\'] . &quot;\', date_added = NOW()&quot;);\r\n\t\t\t]]&gt;&lt;/search&gt;\r\n\t\t\t&lt;add position=&quot;replace&quot;&gt;&lt;![CDATA[ \r\n\t\t\t$userac = $this-&gt;registry-&gt;get(\'user\');\t\t\r\n\t\t\t$data[\'user_group_name\'] = $userac-&gt;user_group_name;\r\n\t\t\tif($data[\'user_group_name\']==\'Store admin\') {\r\n\t\t\t\t$user_store_id = $userac-&gt;store_id;\t\t\t\r\n\t\t\t\t$this-&gt;db-&gt;query(&quot;INSERT INTO &quot; . DB_PREFIX . &quot;customer SET customer_group_id = \'&quot; . (int)$data[\'customer_group_id\'] . &quot;\', firstname = \'&quot; . $this-&gt;db-&gt;escape($data[\'firstname\']) . &quot;\', lastname = \'&quot; . $this-&gt;db-&gt;escape($data[\'lastname\']) . &quot;\', email = \'&quot; . $this-&gt;db-&gt;escape($data[\'email\']) . &quot;\', telephone = \'&quot; . $this-&gt;db-&gt;escape($data[\'telephone\']) . &quot;\', custom_field = \'&quot; . $this-&gt;db-&gt;escape(isset($data[\'custom_field\']) ? json_encode($data[\'custom_field\']) : json_encode(array())) . &quot;\', newsletter = \'&quot; . (int)$data[\'newsletter\'] . &quot;\', salt = \'&quot; . $this-&gt;db-&gt;escape($salt = token(9)) . &quot;\', password = \'&quot; . $this-&gt;db-&gt;escape(sha1($salt . sha1($salt . sha1($data[\'password\'])))) . &quot;\', status = \'&quot; . (int)$data[\'status\'] . &quot;\', safe = \'&quot; . (int)$data[\'safe\'] . &quot;\', date_added = NOW(), store_id=$user_store_id&quot;);\r\n\t\t\t}else{\r\n\t\t\t\t$this-&gt;db-&gt;query(&quot;INSERT INTO &quot; . DB_PREFIX . &quot;customer SET customer_group_id = \'&quot; . (int)$data[\'customer_group_id\'] . &quot;\', firstname = \'&quot; . $this-&gt;db-&gt;escape($data[\'firstname\']) . &quot;\', lastname = \'&quot; . $this-&gt;db-&gt;escape($data[\'lastname\']) . &quot;\', email = \'&quot; . $this-&gt;db-&gt;escape($data[\'email\']) . &quot;\', telephone = \'&quot; . $this-&gt;db-&gt;escape($data[\'telephone\']) . &quot;\', custom_field = \'&quot; . $this-&gt;db-&gt;escape(isset($data[\'custom_field\']) ? json_encode($data[\'custom_field\']) : json_encode(array())) . &quot;\', newsletter = \'&quot; . (int)$data[\'newsletter\'] . &quot;\', salt = \'&quot; . $this-&gt;db-&gt;escape($salt = token(9)) . &quot;\', password = \'&quot; . $this-&gt;db-&gt;escape(sha1($salt . sha1($salt . sha1($data[\'password\'])))) . &quot;\', status = \'&quot; . (int)$data[\'status\'] . &quot;\', safe = \'&quot; . (int)$data[\'safe\'] . &quot;\', date_added = NOW()&quot;);\r\n\t\t\t}\r\n\t\t\t]]&gt;&lt;/add&gt;\r\n\t\t&lt;/operation&gt;\r\n\t\t&lt;operation error=&quot;skip&quot;&gt;\