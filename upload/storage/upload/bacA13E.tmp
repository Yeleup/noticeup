TRUNCATE TABLE `oc_architect`;

INSERT INTO `oc_architect` (`architect_id`, `module_id`, `identifier`, `name`, `controller`, `model`, `template`, `modification`, `event`, `option`, `meta`, `status`, `publish`, `unpublish`, `created`, `updated`) VALUES ('1', '33', 'arc5eada7e90fda5', 'Noticeup Admin Manager', '&lt;?php\r\nclass {controller_class} extends Controller\r\n{\r\n    public function index($param = array())\r\n    {\r\n        $data = $this-&gt;language();\r\n\r\n        // Your code here..\r\n\r\n        return $this-&gt;load-&gt;view(\'{template_path}\', $data);\r\n    }\r\n\r\n    protected function language($data = array())\r\n    {\r\n        $_[\'heading\']  = \'Architect\';\r\n        $_[\'greeting\'] = \'Hello World\';\r\n\r\n        return array_merge($data, $_);\r\n    }\r\n}', '&lt;?php\r\nclass {model_class} extends Model\r\n{\r\n    public function get($param = array())\r\n    {\r\n\r\n        // Usage in controller\r\n        // $this-&gt;load-&gt;model(\'{model_path}\');\r\n        // $data = $this-&gt;{model_call}-&gt;get(array());\r\n\r\n        return $data;\r\n    }\r\n}', '&lt;div class=&quot;module architect arc-{module_id}&quot;&gt;\r\n    &lt;div class=&quot;module-heading&quot;&gt;\r\n        &lt;h3&gt;{{ heading }}&lt;/h3&gt;\r\n    &lt;/div&gt;\r\n    &lt;div class=&quot;module-body&quot;&gt;\r\n        {{ greeting }}\r\n    &lt;/div&gt;\r\n&lt;/div&gt;', '&lt;modification&gt;\r\n    &lt;name&gt;{ocmod_name}&lt;/name&gt;\r\n    &lt;version&gt;1.0.1&lt;/version&gt;\r\n    &lt;link&gt;...&lt;/link&gt;\r\n    &lt;author&gt;{author}&lt;/author&gt;\r\n    &lt;code&gt;{ocmod_code}&lt;/code&gt;\r\n\r\n    &lt;file path=&quot;admin/view/template/common/header.twig&quot;&gt;\r\n        &lt;operation error=&quot;skip&quot;&gt;\r\n            &lt;search&gt;&lt;![CDATA[&lt;ul class=&quot;nav navbar-nav navbar-right&quot;&gt;]]&gt;&lt;/search&gt;\r\n            &lt;add position=&quot;after&quot;&gt;&lt;![CDATA[&lt;li&gt;&lt;a href=&quot;#&quot;&gt;Arc Test #{module_id}&lt;/a&gt;&lt;/li&gt;]]&gt;&lt;/add&gt;\r\n        &lt;/operation&gt;\r\n    &lt;/file&gt;\r\n&lt;/modification&gt;', '&lt;?php\r\nclass {event_class} extends Controller\r\n{\r\n    /**\r\n     * @trigger  catalog/model/catalog/product/getProduct/after\r\n     * @action   {event_path}/foo\r\n     * @order    1\r\n     */\r\n    public function foo(&amp;$route, &amp;$data)\r\n    {\r\n        // Your code here..\r\n        print_r(\'MAGZHAN\');die;\r\n    }\r\n\r\n    /**\r\n     * @trigger  catalog/view/common/footer/after\r\n     * @action   {event_path}/bar\r\n     * @order    2\r\n     */\r\n    public function bar(&amp;$route, &amp;$data, &amp;$output)\r\n    {\r\n        // Your code here..\r\n    }\r\n}', '{"customer_group":"1","customer_group_ids":["0","1"]}', '{"author":"magzhan9292","note":"","editor":{"controller":"1","model":"1","template":"1","modification":"1","event":"1"}}', '1', '2020-05-02 00:00:00', '0000-00-00 00:00:00', '2020-05-02 23:07:01', '2020-05-02 23:47:27');
INSERT INTO `oc_architect` (`architect_id`, `module_id`, `identifier`, `name`, `controller`, `model`, `template`, `modification`, `event`, `option`, `meta`, `status`, `publish`, `unpublish`, `created`, `updated`) VALUES ('2', '34', 'arc5f2be4a406692', 'Admin store', '&lt;?php\r\nclass {controller_class} extends Controller\r\n{\r\n    public function index($param = array())\r\n    {\r\n        $data = $this-&gt;language();\r\n\r\n        // Your code here..\r\n\r\n        return $this-&gt;load-&gt;view(\'{template_path}\', $data);\r\n    }\r\n\r\n    protected function language($data = array())\r\n    {\r\n        $_[\'heading\']  = \'Architect\';\r\n        $_[\'greeting\'] = \'Hello World\';\r\n\r\n        return array_merge($data, $_);\r\n    }\r\n}', '&lt;?php\r\nclass {model_class} extends Model\r\n{\r\n    public function get($param = array())\r\n    {\r\n        $data = array();\r\n\r\n        // Usage in controller\r\n        // $this-&gt;load-&gt;model(\'{model_path}\');\r\n        // $data = $this-&gt;{model_call}-&gt;get(array());\r\n\r\n        return $data;\r\n    }\r\n}', '&lt;div class=&quot;module architect arc-{module_id}&quot;&gt;\r\n    &lt;div class=&quot;module-heading&quot;&gt;\r\n        &lt;h3&gt;{{ heading }}&lt;/h3&gt;\r\n    &lt;/div&gt;\r\n    &lt;div class=&quot;module-body&quot;&gt;\r\n        {{ greeting }}\r\n    &lt;/div&gt;\r\n&lt;/div&gt;', '&lt;modification&gt;\r\n    &lt;name&gt;{ocmod_name}&lt;/name&gt;\r\n    &lt;version&gt;3.0.0.0&lt;/version&gt;\r\n    &lt;link&gt;http://oc.mightytech.org&lt;/link&gt;\r\n    &lt;author&gt;Ataul Haque {author}&lt;/author&gt;\r\n    &lt;code&gt;admin_store.ocmod&lt;/code&gt;\r\n\r\n\t&lt;file path=&quot;admin/language/en-gb/user/user.php&quot;&gt;\t\r\n\t\t&lt;operation error=&quot;skip&quot;&gt; \r\n\t\t\t&lt;search&gt;&lt;![CDATA[$_[\'entry_user_group\']      = \'User Group\';]]&gt;&lt;/search&gt;\r\n\t\t  &lt;add position=&quot;after&quot;&gt;&lt;![CDATA[$_[\'entry_store\'] \t\t= \'Store\';]]&gt;\r\n\t\t  &lt;/add&gt;\t\t  \r\n\t\t&lt;/operation&gt;\r\n\t&lt;/file&gt;\t\t\t\r\n\t&lt;file path=&quot;admin/view/template/user/user_form.twig&quot;&gt;\r\n\t\t&lt;operation error=&quot;skip&quot;&gt; \r\n\t\t\t&lt;search &gt;&lt;![CDATA[&lt;option value=&quot;{{ user_group.user_group_id }}&quot;&gt;{{ user_group.name }}&lt;/option&gt;]]&gt;&lt;/search&gt;\r\n\t\t  &lt;add position=&quot;after&quot;&gt;&lt;![CDATA[\r\n\t\t\t\t\t{% endif %}\r\n                {% endfor %}\r\n              &lt;/select&gt;\r\n            &lt;/div&gt;\r\n          &lt;/div&gt;\r\n\t\t  &lt;div class=&quot;form-group {{ store_id_container_class}}&quot; id=&quot;store_id_container&quot;&gt;\r\n\t\t\t&lt;script&gt;\r\n\t\t\t$(document).ready(function() {\r\n\t\t\t\tvar user_group = $(&quot;#input-user-group option[value=&quot;+$(\'#input-user-group\').val()+&quot;]&quot;).text();\t\r\n\t\t\t\t{% if user_group_name!=\'Store admin\'%}\r\n\t\t\t\tif(user_group==\'Store admin\'){\r\n\t\t\t\t\t$(\'#store_id_container\').removeClass(\'hide\');\r\n\t\t\t\t}\r\n\t\t\t\t{% endif %}\r\n\t\t\t});\r\n\t\t\t$(\'#input-user-group\').change(function(){\r\n\t\t\t\tvar user_group_id = $(this).val();\t\r\n\t\t\t\tvar user_group = $(&quot;#input-user-group option[value=&quot;+user_group_id+&quot;]&quot;).text();\t\r\n\t\t\t\tif(user_group==\'Store admin\'){\r\n\t\t\t\t\t{% if user_group_name!=\'Store admin\'%}\r\n\t\t\t\t\t\t$(\'#store_id_container\').removeClass(\'hide\');\r\n\t\t\t\t\t{% endif %}\t\r\n\t\t\t\t}else{\r\n\t\t\t\t\t$(\'#store_id_container\').addClass(\'hide\');\r\n\t\t\t\t}\r\n\t\t\t})\r\n\t\t\t&lt;/script&gt;\r\n            &lt;label class=&quot;col-sm-2 control-label&quot; for=&quot;input-user-group&quot;&gt;{{entry_store}}&lt;/label&gt;\r\n            &lt;div class=&quot;col-sm-10&quot;&gt;\r\n              &lt;select name=&quot;store_id&quot; id=&quot;input-store-id&quot; class=&quot;form-control&quot;&gt;\r\n                {% for store in stores %}\r\n                {% if store.store_id in store_id %}\r\n\t\t\t\t\t&lt;option value=&quot;{{store.store_id}}&quot; selected=&quot;selected&quot;&gt;{{store.name}}&lt;/option&gt;\r\n                {% else %}\r\n\t\t\t\t\t&lt;option value=&quot;{{store.store_id}}&quot;&gt;{{store.name}}&lt;/option&gt;\r\n                \t\t  \r\n\t\t  ]]&gt;\r\n\t\t  &lt;/add&gt;\t\t  \r\n\t\t&lt;/operation&gt;\r\n\t&lt;/file&gt;\r\n\t&lt;file path=&quot;admin/controller/user/user.php&quot;&gt;\r\n\t\t&lt;operation error=&quot;skip&quot;&gt; \r\n\t\t\t&lt;search &gt;&lt;![CDATA[\r\n\t\t\t$data[\'user_groups\'] = $this-&gt;model_user_user_group-&gt;getUserGroups();]]&gt;&lt;/search&gt;\r\n\t\t  &lt;add position=&quot;after&quot;&gt;&lt;![CDATA[$data[\'entry_store\'] = $this-&gt;language-&gt;get(\'entry_store\');\t\t\r\n\t\tif(isset($user_info)&amp;&amp;$user_info[\'user_group\']==\'Store admin\'){\r\n\t\t\t$data[\'store_id_container_class\'] = \'\';\r\n\t\t\t$data[\'store_id\'] = $user_info[\'store_id\'];\r\n\t\t}else{\r\n\t\t\t$data[\'store_id_container_class\'] = \'hide\';\r\n\t\t\tif(!isset($data[\'store_id\']))\r\n\t\t\t\t$data[\'store_id\'] = 0;\r\n\t\t}\r\n\t\t$this-&gt;load-&gt;model(\'setting/store\');\r\n\t\t$data[\'stores\'] = $this-&gt;model_setting_store-&gt;getStores();\r\n\t\t$data[\'config_name\'] = $this-&gt;config-&gt;get(\'config_name\');\t\t\r\n\t\t]]&gt;\r\n\t\t  &lt;/add&gt;\t\t  \r\n\t\t&lt;/operation&gt;\r\n\t\t&lt;operation error=&quot;skip&quot;&gt; \r\n\t\t\t&lt;search &gt;&lt;![CDATA[protected function getForm() {]]&gt;&lt;/search&gt;\r\n\t\t  &lt;add position=&quot;after&quot;&gt;&lt;![CDATA[\r\n\t\t\t$userac = $this-&gt;registry-&gt;get(\'user\');\t\t\r\n\t\t\t$data[\'user_group_name\'] = $userac-&gt;user_group_name;\r\n\t\t\t$data[\'store_id\'] = $userac-&gt;store_id;\t\t\t\t\r\n\t\t]]&gt;\r\n\t\t  &lt;/add&gt;\t\t  \r\n\t\t&lt;/operation&gt;\t\t\r\n\t&lt;/file&gt;\r\n\t&lt;file path=&quot;admin/model/user/user.php&quot;&gt;\r\n\t\t&lt;operation error=&quot;skip&quot;&gt; \r\n\t\t\t&l