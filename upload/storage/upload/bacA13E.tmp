me }}</td>\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t<td {% if user_group_name==\'Store admin\' and store.store_id!=user_store_id %} style="display:none" {% endif %} class="text-left">{{ store.name }}</td>\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\t\t\t\n\t\t\t<td class="text-left"><select name="information_layout[{{ store.store_id }}]" class="form-control">\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[\t\t\n\t\t\t<td {% if user_group_name==\'Store admin\' and store.store_id!=user_store_id %} style="display:none" {% endif %} class="text-left"><select name="information_layout[{{ store.store_id }}]" class="form-control">\t\t\t\n\t\t\t]]></add>\n\t\t</operation>\t\t\n\t</file>\n\t<!-- Manufacturer -->\n\t<file path="admin/language/en-gb/catalog/manufacturer.php">\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t\t// Error\n\t\t\t]]></search>\n\t\t\t<add position="after"><![CDATA[\n\t\t\t$_[\'error_not_found\']        = \'Warning: Manufacturer not found!\';\n\t\t\t]]></add>\n\t\t</operation>\n\t</file>\t\n\t<file path="admin/controller/catalog/manufacturer.php">\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\tprotected function getForm() {\n\t\t\t]]></search>\n\t\t\t<add position="after"><![CDATA[\n\t\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\t\t$data[\'user_group_name\'] = $userac->user_group_name;\t\t\t\t\t\t\t\t\n\t\t\t\t$data[\'user_store_id\'] = $userac->store_id;\t\t\t\t\t\t\t\t\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t$data[\'manufacturer_store\'] = array(0);\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t\t$userac = $this->registry->get(\'user\');\n\t\t\t\tif($userac->user_group_name==\'Store admin\'){\t\t\t\t\t\t\t\t\n\t\t\t\t\t$data[\'manufacturer_store\'] = array($userac->store_id);\n\t\t\t\t}else{\n\t\t\t\t\t$data[\'manufacturer_store\'] = array(0);\n\t\t\t\t}\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[\n\t\t\t$manufacturer_info = $this->model_catalog_manufacturer->getManufacturer($this->request->get[\'manufacturer_id\']);\n\t\t\t]]></search>\n\t\t\t<add position="before"><![CDATA[ \n\t\t\tif(!$this->model_catalog_manufacturer->checkManufacturerForStore($this->request->get[\'manufacturer_id\'])){\n\t\t\t\t$this->session->data[\'error\'] = $this->language->get(\'error_not_found\');\n\t\t\t\t$this->response->redirect($this->url->link(\'catalog/manufacturer\', \'user_token=\' . $this->session->data[\'user_token\'] . $url, true));\n\t\t\t}]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[\n\t\t\t$data[\'error_warning\'] = \'\';\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\tif (isset($this->session->data[\'error\'])) {\n\t\t\t\t$data[\'error_warning\'] = $this->session->data[\'error\'];\n\n\t\t\t\tunset($this->session->data[\'error\']);\n\t\t\t} else {\n\t\t\t\t$data[\'error_warning\'] = \'\';\n\t\t\t}\n\t\t]]></add>\n\t\t</operation>\t\t\n\t</file>\t\n\t<file path="admin/view/template/catalog/manufacturer_form.twig">\n\t\t<operation error="skip">\n\t\t\t<search index="0"><![CDATA[\n\t\t\t<div class="form-group">\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t\t{% if user_group_name==\'Store admin\'%}\n\t\t\t\t\t<div class="form-group" style="display:none;">\n\t\t\t\t{% else %}\n\t\t\t\t\t<div class="form-group">\n\t\t\t\t{% endif %}\t\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t<li><a href="#tab-seo" data-toggle="tab">{{ tab_seo }}</a></li>\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t\t{% if user_group_name!=\'Store admin\'%}\n\t\t\t\t\t<li><a href="#tab-seo" data-toggle="tab">{{ tab_seo }}</a></li>\t\t\t\t\n\t\t\t\t{% endif %}\n\t\t\t]]></add>\n\t\t</operation>\t\t\t\t\t\t\n\t</file>\t\n\t<file path="admin/model/catalog/manufacturer.php">\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t\tpublic function getManufacturer($manufacturer_id) {\n\t\t\t]]></search>\n\t\t\t<add position="before"><![CDATA[\n\t\t\tpublic function checkManufacturerForStore($manufacturer_id){\n\t\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\t\tif($userac->user_group_name==\'Store admin\') {\t\t\t\t\n\t\t\t\t\t$sql = "SELECT count(manufacturer_id) as total FROM " . DB_PREFIX . "manufacturer_to_store m2s WHERE m2s.manufacturer_id=$manufacturer_id AND m2s.store_id=".$userac->store_id;\n\t\t\t\t\t$result = $this->db->query($sql)->row;\n\t\t\t\t\tif($result[\'total\']==0){\n\t\t\t\t\t\treturn false;\n\t\t\t\t\t}else{\n\t\t\t\t\t\treturn true;\n\t\t\t\t\t}\t\t\t\n\t\t\t\t}else{\n\t\t\t\t\treturn true;\n\t\t\t\t}\n\t\t\t}\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[public function deleteManufacturer($manufacturer_id) {]]></search>\n\t\t\t<add position="after"><![CDATA[\n\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\tif($userac->user_group_name==\'Store admin\') {\n\t\t\t\t$query = $this->db->query("SELECT COUNT(store_id) AS total FROM " . DB_PREFIX . "manufacturer_to_store WHERE manufacturer_id = " . (int)$manufacturer_id);\n\t\t\t\t$row = $query->row;\t\t\t\t\n\t\t\t\tif($row[\'total\']>1){\n\t\t\t\t\t$this->db->query("DELETE FROM " . DB_PREFIX . "manufacturer_to_store WHERE manufacturer_id = \'" . (int)$manufacturer_id . "\' AND store_id=".$userac->store_id);\n\t\t\t\t\t$this->cache->delete(\'manufacturer\');\n\t\t\t\t\treturn;\n\t\t\t\t}\t\t\t\t\n\t\t\t}\n\t\t\t]]></add>\n\t\t</operation>\n\t</file>\n\t<file path="admin/model/catalog/product.php">\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[$query = $this->db->query("SELECT COUNT(*) AS total FROM " . DB_PREFIX . "product WHERE manufacturer_id = \'" . (int)$manufacturer_id . "\'");]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\tif($userac->user_group_name==\'Store admin\') {\n\t\t\t\t$sql = "SELECT COUNT(*) AS total FROM " . DB_PREFIX . "product p\n\t\t\t\t\t\tINNER JOIN " . DB_PREFIX . "product_to_store p2s ON p2s.product_id = p.product_id\n\t\t\t\t\t\tWHERE manufacturer_id = \'" . (int)$manufacturer_id . "\' AND p2s.store_id=".$userac->store_id;\n\t\t\t\t$query = $this->db->query($sql);\n\t\t\t\treturn $query->row[\'total\'];\t\t\t\t\n\t\t\t}\n\t\t\t]]></add>\n\t\t</operation>\n\t</file>\t\n\t<!-- Filter Manufacturer -->\n\t<file path="admin/model/catalog/manufacturer.php">\t\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[\n\t\t\t$sql = "SELECT * FROM " . DB_PREFIX . "manufacturer";\n\t\t\t]]></search>\n\t\t\t<add position="after"><![CDATA[ \n\t\t\tif (isset($data[\'filter_store\'])) {\n\t\t\t\tif (!empty($data[\'filter_store\'])) {\n\t\t\t\t\t$sql .= " INNER JOIN ".DB_PREFIX . "manufacturer_to_store m2s ON m2s.manufacturer_id=".DB_PREFIX."manufacturer.manufacturer_id ";\n\t\t\t\t}\n\t\t\t}\n\t\t\t  ]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t$sort_data = array(\n\t\t\t]]></search>\n\t\t\t<add position="before"><![CDATA[\n\t\t\t\tif (isset($data[\'filter_store\'])) {\n\t\t\t\t\tif (!empty($data[\'filter_store\'])) {\n\t\t\t\t\t\t$sql .= " AND m2s.store_id = \'".$data[\'filter_store\']."\'";\n\t\t\t\t\t}else{\n\t\t\t\t\t\t$sql .= " WHERE m2s.store_id = \'".$data[\'filter_store\']."\'";\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t]]></add>\n\t\t</operation>\t\t\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total FROM " . DB_PREFIX . "manufacturer");\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\tif($userac->user_group_name==\'Store admin\') {\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total FROM " . DB_PREFIX . "manufacturer m INNER JOIN " . DB_PREFIX . "manufacturer_to_store m2s ON 