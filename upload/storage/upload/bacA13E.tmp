TRUNCATE TABLE `oc_modification`;

INSERT INTO `oc_modification` (`modification_id`, `extension_install_id`, `name`, `code`, `author`, `version`, `link`, `xml`, `status`, `date_added`) VALUES ('2', '3', 'Noticeup SEO Multistore Template', 'noticeup_seo_multistore_template', 'Magzhan Yeleup, magzhan9292@gmail.com', '1.1.9.6', 'https://opencartforum.com/files/file/5891-noticeup-seo-generator-shablonov-i-tegov-dlya-multimagazin/', '<?xml version="1.0" encoding="UTF-8"?>\r\n<modification>\r\n    <name>Noticeup SEO Multistore Template</name>\r\n    <link>https://opencartforum.com/files/file/5891-noticeup-seo-generator-shablonov-i-tegov-dlya-multimagazin/</link>\r\n    <author>Magzhan Yeleup, magzhan9292@gmail.com</author>\r\n    <code>noticeup_seo_multistore_template</code>\r\n    <version>1.1.9.6</version>\r\n    <!--Opencart версия 3.0.x-->\r\n\r\n    <!--Admin-->\r\n    <!--Edit Product-->\r\n    <file path="admin/model/catalog/product.php">\r\n        <operation>\r\n            <search index="0"><![CDATA[$this->db->query("DELETE FROM " . DB_PREFIX . "product_description WHERE product_id = \'" . (int)$product_id . "\'");]]></search>\r\n            <add position="replace" offset="4"><![CDATA[\r\n        //Noticeup SEO Multistore Product Template\r\n\t\tif(isset($this->request->get[\'store_id\'])) {\r\n            $this->db->query("DELETE FROM " . DB_PREFIX . "noticeup_seo_product WHERE store_id = \'" . (int)$this->request->get[\'store_id\'] . "\' AND product_id = \'" . (int)$product_id . "\'");\r\n\r\n            foreach ($data[\'product_description\'] as $language_id => $value) {\r\n                $this->db->query("INSERT INTO " . DB_PREFIX . "noticeup_seo_product SET store_id = \'" . (int)$this->request->get[\'store_id\'] . "\', product_id = \'" . (int)$product_id . "\', language_id = \'" . (int)$language_id . "\', name = \'" . $this->db->escape($value[\'name\']) . "\', description = \'" . $this->db->escape($value[\'description\']) . "\', tag = \'" . $this->db->escape($value[\'tag\']) . "\', meta_title = \'" . $this->db->escape($value[\'meta_title\']) . "\', meta_description = \'" . $this->db->escape($value[\'meta_description\']) . "\', meta_keyword = \'" . $this->db->escape($value[\'meta_keyword\']) . "\'");\r\n\r\n                //Для сборки Ocstore\r\n            \tif(isset($value[\'meta_h1\'])){\r\n            \t\t$this->db->query("UPDATE " . DB_PREFIX . "noticeup_seo_product SET meta_h1 = \'" . $this->db->escape($value[\'meta_h1\']) . "\' WHERE store_id = \'" . (int) $this->request->get[\'store_id\'] . "\' AND product_id = \'" . (int) $product_id . "\' AND language_id = \'" . (int) $language_id . "\'");\r\n            \t}\r\n            }\r\n        }else{\r\n            $this->db->query("DELETE FROM " . DB_PREFIX . "noticeup_seo_product WHERE store_id = \'0\' AND product_id = \'" . (int)$product_id . "\'");\r\n\r\n            foreach ($data[\'product_description\'] as $language_id => $value) {\r\n                $this->db->query("INSERT INTO " . DB_PREFIX . "noticeup_seo_product SET store_id = \'0\', product_id = \'" . (int)$product_id . "\', language_id = \'" . (int)$language_id . "\', name = \'" . $this->db->escape($value[\'name\']) . "\', description = \'" . $this->db->escape($value[\'description\']) . "\', tag = \'" . $this->db->escape($value[\'tag\']) . "\', meta_title = \'" . $this->db->escape($value[\'meta_title\']) . "\', meta_description = \'" . $this->db->escape($value[\'meta_description\']) . "\', meta_keyword = \'" . $this->db->escape($value[\'meta_keyword\']) . "\'");\r\n\r\n            \t//Для сборки Ocstore\r\n            \tif(isset($value[\'meta_h1\'])){\r\n            \t\t$this->db->query("UPDATE " . DB_PREFIX . "noticeup_seo_product SET meta_h1 = \'" . $this->db->escape($value[\'meta_h1\']) . "\' WHERE store_id = \'0\' AND product_id = \'" . (int) $product_id . "\' AND language_id = \'" . (int) $language_id . "\'");\r\n            \t}\r\n            }\r\n\r\n            $this->db->query("DELETE FROM " . DB_PREFIX . "product_description WHERE product_id = \'" . (int)$product_id . "\'");\r\n\r\n            foreach ($data[\'product_description\'] as $language_id => $value) {\r\n                $this->db->query("INSERT INTO " . DB_PREFIX . "product_description SET product_id = \'" . (int)$product_id . "\', language_id = \'" . (int)$language_id . "\', name = \'" . $this->db->escape($value[\'name\']) . "\', description = \'" . $this->db->escape($value[\'description\']) . "\', tag = \'" . $this->db->escape($value[\'tag\']) . "\', meta_title = \'" . $this->db->escape($value[\'meta_title\']) . "\', meta_description = \'" . $this->db->escape($value[\'meta_description\']) . "\', meta_keyword = \'" . $this->db->escape($value[\'meta_keyword\']) . "\'");\r\n\r\n            \t//Для сборки Ocstore\r\n            \tif(isset($value[\'meta_h1\'])){\r\n            \t\t$this->db->query("UPDATE " . DB_PREFIX . "product_description SET meta_h1 = \'" . $this->db->escape($value[\'meta_h1\']) . "\' WHERE product_id = \'" . (int) $product_id . "\' AND language_id = \'" . (int) $language_id . "\'");\r\n            \t}\r\n            }\r\n        }]]></add>\r\n        </operation>\r\n        <operation>\r\n            <search><![CDATA[$product_description_data = array();]]></search>\r\n            <add position="after"><![CDATA[\r\n\t\t//Noticeup SEO Multistore Product Template\r\n\t\tif(isset($this->request->get[\'store_id\'])){\r\n            $query = $this->db->query("SELECT * FROM " . DB_PREFIX . "noticeup_seo_product WHERE store_id = \'" . (int)$this->request->get[\'store_id\'] . "\' AND product_id = \'" . (int)$product_id . "\'");\r\n\r\n            foreach ($query->rows as &$result) {\r\n                $product_description_data[$result[\'language_id\']] = array(\r\n                    \'name\' => $result[\'name\'],\r\n                    \'description\' => $result[\'description\'],\r\n                    \'meta_title\' => $result[\'meta_title\'],\r\n                    \'meta_h1\' => (isset($result[\'meta_h1\']) ? $result[\'meta_h1\'] : \'\'),\r\n                    \'meta_description\' => $result[\'meta_description\'],\r\n                    \'meta_keyword\' => $result[\'meta_keyword\'],\r\n                    \'tag\' => $result[\'tag\']\r\n                );\r\n            }\r\n\r\n            return $product_description_data;\r\n        }]]></add>\r\n        </operation>\r\n    </file>\r\n    <file path="admin/view/template/catalog/product_form.twig">\r\n        <operation>\r\n            <search><![CDATA[<div class="panel-body">]]></search>\r\n            <add position="after"><![CDATA[\r\n        <!--Noticeup SEO Multistore Product Template-->\r\n\t\t<div class="form-group">\r\n          <select class="form-control" id="select_store">\r\n            {% for store in stores %}\r\n                {% if store.store_id == 0 %}\r\n                    <option value="{{ action }}">{{ store.name }}</option>\r\n                    <option data-store-id="{{ store.store_id }}" value="{{ action }}&store_id={{ store.store_id }}">{{ store.name }} (Noticeup SEO)</option>\r\n                {% else %}\r\n                    <option data-store-id="{{ store.store_id }}" value="{{ action }}&store_id={{ store.store_id }}">{{ store.name }}</option>\r\n                {% endif %}\r\n            {% endfor %}\r\n          </select>\r\n        </div>\r\n\r\n        <script>\r\n          $( document ).ready(function(){\r\n\r\n            var url = new URL(location.href);\r\n\r\n            var searchParams = new URLSearchParams(url.search.substring(1));\r\n\r\n            var store_id = searchParams.get("store_id");\r\n\r\n            $.each($(\'#select_store option\').toArray(),function(key, data) {\r\n\r\n              if(store_id != null && store_id == $(this).attr(\'data-store-id\')){\r\n                $("#form-product").attr("action", $("#form-product").attr("action") + \'&store_id=\' + store_id);\r\n                data.selected = true;\r\n              }\r\n            });\r\n          });\r\n\r\n          $(\'#select_store\').change(function() {\r\n            // set the window\'s location property to the value of the option the user has selected\r\n            window.location = $(this).val();\r\n          });\r\n        </script>\r\n        <!--Noticeup SEO Multistore Product Template-->]]></add>\r\n        </operation>\r\n    </file>\r\n\r\n    <!--Edit Category-->\r\n    <file path="admin/model/catalog/category.php">\r\n        <operation>\r\n            <search index="0"><![CDATA[$this->db->query("DELETE FROM " . DB_PREFIX . "category_description WHERE category_id = \'" . (int)$category_id . "\'");]]></search>\r\n            <add position="replace" offset="4"><![CDATA[\r\n\t\t//Noticeup SEO Multistore Category Template\r\n\t\tif(isset($this->request->get[\'store_id\'])) {\r\n            $this->db->query("DELETE FROM " . DB_PREFIX . "noticeup_seo_category WHERE store_id = \'" . (int)$this->request->get[\'store_id\'] . "\' AND category_id = \'" . (int)$category_id . "\'");\r\n\r\n            foreach ($data[\'category_description\'] as $language_id => $value) {\r\n\t\t\t\t$this->db->query("INSERT INTO " . DB_PREFIX . "noticeup_seo_category SET store_id = \'" . (int)$this->request->get[\'store_id\'] . "\', category_id = \'" . (int)$category_id . "\', language_id = \'" . (int)$language_id . "\', name = \'" . $this->db->escape($value[\'name\']) . "\', description = \'" . $this->db->escape($value[\'description\']) . "\', meta_title = \'" . $this->db->escape($value[\'meta_title\']) . "\', meta_description = \'" . $this->db->escape($value[\'meta_description\']) . "\', meta_keyword = \'" . $this->db->escape($value[\'meta_keyword\']) . "\'");\r\n\r\n\t\t\t\t//Для сборки Ocstore\r\n            \tif(isset($value[\'meta_h1\'])){\r\n            \t\t$this->db->query("UPDATE " . DB_PREFIX . "noticeup_seo_category SET meta_h1 = \'" . $this->db->escape($value[\'meta_h1\']) . "\' WHERE store_id = \'" . (int) $this->request->get[\'store_id\'] . "\' AND category_id = \'" . (int) $category_id . "\' AND language_id = \'" . (int) $language_id . "\'");\r\n            \t}\r\n\t\t\t}\r\n        }else{\r\n        \t$this->db->query("DELETE FROM " . DB_PREFIX . "noticeup_seo_category WHERE store_id = \'0\' AND category_id = \'" . (int)$category_id . "\'");\r\n\r\n            foreach ($data[\'category_description\'] as $language_id => $value) {\r\n\t\t\t\t$this->db->query("INSERT INTO " . DB_PREFIX . "noticeup_seo_category SET store_id = \'0\', category_id = \'" . (int)$category_id . "\', language_id = \'" . (int)$language_id . "\', name = \'" . $this->db->escape($value[\'name\']) . "\', description = \'" . $this->db->escape($value[\'description\']) . "\', meta_title = \'" . $this->db->escape($value[\'meta_title\']) . "\', meta_description = \'" . $this->db->escape($value[\'meta_description\']) . "\', meta_keyword = \'" . $this->db->escape($value[\'meta_keyword\']) . "\'");\r\n\r\n\t\t\t\t//Для сборки Ocstore\r\n            \tif(isset($value[\'meta_h1\'])){\r\n            \t\t$this->db->query("UPDATE " . DB_PREFIX . "noticeup_seo_category SET meta_h1 = \'" . $this->db->escape($value[\'meta_h1\']) . "\' WHERE store_id = \'0\' AND category_id = \'" . (int) $category_id . "\' AND language_id = \'" . (int) $language_id . "\'");\r\n            \t}\r\n\t\t\t}\r\n\r\n        \t$this->db->query("DELETE FROM " . DB_PREFIX . "category_description WHERE category_id = \'" . (int)$category_id . "\'");\r\n\r\n            foreach ($data[\'category_description\'] as $language_id => $value) {\r\n\t\t\t\t$this->db->query("INSERT INTO " . DB_PREFIX . "category_description SET category_id = \'" . (int)$category_id . "\', language_id = \'" . (int)$language_id . "\', name = \'" . $this->db->escape($value[\'name\']) . "\', description = \'" . $this->db->escape($value[\'description\']) . "\', meta_title = \'" . $this->db->escape($value[\'meta_title\']) . "\', meta_description = \'" . $this->db->escape($value[\'meta_description\']) . "\', meta_keyword = \'" . $this->db->escape($value[\'meta_keyword\']) . "\'");\r\n\r\n\t\t\t\t//Для сборки Ocstore\r\n            \tif(isset($value[\'meta_h1\'])){\r\n            \t\t$this->db->query("UPDATE " . DB_PREFIX . "category_description SET meta_h1 = \'" . $this->db->escape($value[\'meta_h1\']) . "\' WHERE category_id = \'" . (int) $category_id . "\' AND language_id = \'" . (int) $language_id . "\'");\r\n            \t}\r\n\t\t\t}\r\n        }]]></add>\r\n        </operation>\r\n        <operation>\r\n            <search><![CDATA[$category_description_data = array();]]></search>\r\n            <add position="after"><![CDATA[\r\n\t\t//Noticeup SEO Multistore Product Template\r\n\t\tif(isset($this->request->get[\'store_id\'])){\r\n            $query = $this->db->query("SELECT * FROM " . DB_PREFIX . "noticeup_seo_category WHERE store_id = \'" . (int)$this->request->get[\'store_id\'] . "\' AND category_id = \'" . (int)$category_id . "\'");\r\n\r\n            foreach ($query->rows as $result) {\r\n\t\t\t\t$category_description_data[$result[\'language_id\']] = array(\r\n\t\t\t\t\t\'name\'             => $result[\'name\'],\r\n\t\t\t\t\t\'meta_title\'       => $result[\'meta_title\'],\r\n\t\t\t\t\t\'meta_h1\' \t\t   => (isset($result[\'meta_h1\']) ? $result[\'meta_h1\'] : \'\'),\r\n\t\t\t\t\t\'meta_description\' => $result[\'meta_description\'],\r\n\t\t\t\t\t\'meta_keyword\'     => $result[\'meta_keyword\'],\r\n\t\t\t\t\t\'description\'      => $result[\'description\']\r\n\t\t\t\t);\r\n\t\t\t}\r\n\r\n            return $category_description_data;\r\n        }]]></add>\r\n        </operation>\r\n    </file>\r\n    <file path="admin/view/template/catalog/category_form.twig">\r\n        <operation>\r\n            <search><![CDATA[<div class="panel-body">]]></search>\r\n            <add position="after"><![CDATA[\r\n\t\t<div class="form-group">\r\n          <select class="form-control" id="select_store">\r\n            {% for store in stores %}\r\n                {% if store.store_id == 0 %}\r\n                    <option value="{{ action }}">{{ store.name }}</option>\r\n                    <option data-store-id="{{ store.store_id }}" value="{{ action }}&store_id={{ store.store_id }}">{{ store.name }} (Noticeup SEO)</option>\r\n                {% else %}\r\n                    <option data-store-id="{{ store.store_id }}" value="{{ action }}&store_id={{ store.store_id }}">{{ store.name }}</option>\r\n                {% endif %}\r\n            {% endfor %}\r\n          </select>\r\n        </div>\r\n\r\n        <script>\r\n          $( document ).ready(function(){\r\n\r\n            var url = new URL(location.href);\r\n\r\n            var searchParams = new URLSearchParams(url.search.substring(1));\r\n\r\n            var store_id = searchParams.get("store_id");\r\n\r\n            $.each($(\'#select_store option\').toArray(),function(key, data) {\r\n\r\n              if(store_id != null && store_id == $(this).attr(\'data-store-id\')){\r\n                $("#form-category").attr("action", $("#form-category").attr("action") + \'&store_id=\' + store_id);\r\n                data.selected = true;\r\n              }\r\n            });\r\n          });\r\n\r\n          $(\'#select_store\').change(function() {\r\n            // set the window\'s location property to the value of the option the user has selected\r\n            window.location = $(this).val();\r\n          });\r\n        </script>]]></add>\r\n        </operation>\r\n    </file>\r\n</modification>\r\n', '0', '2020-04-13 20:10:44');
INSERT INTO `oc_modification` (`modification_id`, `extension_install_id`, `name`, `code`, `author`, `version`, `link`, `xml`, `status`, `date_added`) VALUES ('14', '9', 'Admin store', 'admin_store.ocmod', 'Ataul Haque', '3.0.0.0', 'http://oc.mightytech.org', '<modification>\n    <name>Admin store</name>\n\t<version>3.0.0.0</version>\n\t<link>http://oc.mightytech.org</link>\n\t<author>Ataul Haque</author>\n\t<code>admin_store.ocmod</code>\n\n\t<file path="admin/language/en-gb/user/user.php">\t\n\t\t<operation error="skip"> \n\t\t\t<search><![CDATA[$_[\'entry_user_group\']      = \'User Group\';]]></search>\n\t\t  <add position="after"><![CDATA[$_[\'entry_store\'] \t\t= \'Store\';]]>\n\t\t  </add>\t\t  \n\t\t</operation>\n\t</file>\t\t\t\n\t<file path="admin/view/template/user/user_form.twig">\n\t\t<operation error="skip"> \n\t\t\t<search ><![CDATA[<option value="{{ user_group.user_group_id }}">{{ user_group.name }}</option>]]></search>\n\t\t  <add position="after"><![CDATA[\n\t\t\t\t\t{% endif %}\n                {% endfor %}\n              </select>\n            </div>\n          </div>\n\t\t  <div class="form-group {{ store_id_container_class}}" id="store_id_container">\n\t\t\t<script>\n\t\t\t$(document).ready(function() {\n\t\t\t\tvar user_group = $("#input-user-group option[value="+$(\'#input-user-group\').val()+"]").text();\t\n\t\t\t\t{% if user_group_name!=\'Store admin\'%}\n\t\t\t\tif(user_group==\'Store admin\'){\n\t\t\t\t\t$(\'#store_id_container\').removeClass(\'hide\');\n\t\t\t\t}\n\t\t\t\t{% endif %}\n\t\t\t});\n\t\t\t$(\'#input-user-group\').change(function(){\n\t\t\t\tvar user_group_id = $(this).val();\t\n\t\t\t\tvar user_group = $("#input-user-group option[value="+user_group_id+"]").text();\t\n\t\t\t\tif(user_group==\'Store admin\'){\n\t\t\t\t\t{% if user_group_name!=\'Store admin\'%}\n\t\t\t\t\t\t$(\'#store_id_container\').removeClass(\'hide\');\n\t\t\t\t\t{% endif %}\t\n\t\t\t\t}else{\n\t\t\t\t\t$(\'#store_id_container\').addClass(\'hide\');\n\t\t\t\t}\n\t\t\t})\n\t\t\t</script>\n            <label class="col-sm-2 control-label" for="input-user-group">{{entry_store}}</label>\n            <div class="col-sm-10">\n              <select name="store_id" id="input-store-id" class="form-control">\n                {% for store in stores %}\n                {% if store.store_id in store_id %}\n\t\t\t\t\t<option value="{{store.store_id}}" selected="selected">{{store.name}}</option>\n                {% else %}\n\t\t\t\t\t<option value="{{store.store_id}}">{{store.name}}</option>\n                \t\t  \n\t\t  ]]>\n\t\t  </add>\t\t  \n\t\t</operation>\n\t</file>\n\t<file path="admin/controller/user/user.php">\n\t\t<operation error="skip"> \n\t\t\t<search ><![CDATA[\n\t\t\t$data[\'user_groups\'] = $this->model_user_user_group->getUserGroups();]]></search>\n\t\t  <add position="after"><![CDATA[$data[\'entry_store\'] = $this->language->get(\'entry_store\');\t\t\n\t\tif(isset($user_info)&&$user_info[\'user_group\']==\'Store admin\'){\n\t\t\t$data[\'store_id_container_class\'] = \'\';\n\t\t\t$data[\'store_id\'] = $user_info[\'store_id\'];\n\t\t}else{\n\t\t\t$data[\'store_id_container_class\'] = \'hide\';\n\t\t\tif(!isset($data[\'store_id\']))\n\t\t\t\t$data[\'store_id\'] = 0;\n\t\t}\n\t\t$this->load->model(\'setting/store\');\n\t\t$data[\'stores\'] = $this->model_setting_store->getStores();\n\t\t$data[\'config_name\'] = $this->config->get(\'config_name\');\t\t\n\t\t]]>\n\t\t  </add>\t\t  \n\t\t</operation>\n\t\t<operation error="skip"> \n\t\t\t<search ><![CDATA[protected function getForm() {]]></search>\n\t\t  <add position="after"><![CDATA[\n\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\t$data[\'user_group_name\'] = $userac->user_group_name;\n\t\t\t$data[\'store_id\'] = $userac->store_id;\t\t\t\t\n\t\t]]>\n\t\t  </add>\t\t  \n\t\t</operation>\t\t\n\t</file>\n\t<file path="admin/model/user/user.php">\n\t\t<operation error="skip"> \n\t\t\t<search ><![CDATA[$this->db->query("INSERT INTO `" . DB_PREFIX . "user` SET username = \'" . $this->db->escape($data[\'username\']) . "\', user_group_id = \'" . (int)$data[\'user_group_id\'] . "\', salt = \'" . $this->db->escape($salt = token(9)) . "\', password = \'" . $this->db->escape(sha1($salt . sha1($salt . sha1($data[\'password\'])))) . "\', firstname = \'" . $this->db->escape($data[\'firstname\']) . "\', lastname = \'" . $this->db->escape($data[\'lastname\']) . "\', email = \'" . $this->db->escape($data[\'email\']) . "\', image = \'" . $this->db->escape($data[\'image\']) . "\', status = \'" . (int)$data[\'status\'] . "\', date_added = NOW()");]]></search>\n\t\t  <add position="replace"><![CDATA[\n\t\t\t$this->load->model(\'user/user_group\');\n\t\t$user_group = $this->model_user_user_group->getUserGroup($data[\'user_group_id\']);\t\t\n\t\tif($user_group[\'name\']==\'Store admin\'){\n\t\t\t$store_id = $data[\'store_id\'];\n\t\t}else{\n\t\t\t$store_id = 0;\n\t\t}\t\t\n\t\t$query = "INSERT INTO `" . DB_PREFIX . "user` SET username = \'" . $this->db->escape($data[\'username\']) . "\', user_group_id = \'" . (int)$data[\'user_group_id\'] ."\' , store_id = \'" . $store_id . "\', salt = \'" . $this->db->escape($salt = token(9)) . "\', password = \'" . $this->db->escape(sha1($salt . sha1($salt . sha1($data[\'password\'])))) . "\', firstname = \'" . $this->db->escape($data[\'firstname\']) . "\', lastname = \'" . $this->db->escape($data[\'lastname\']) . "\', email = \'" . $this->db->escape($data[\'email\']) . "\', image = \'" . $this->db->escape($data[\'image\']) . "\', status = \'" . (int)$data[\'status\'] . "\', date_added = NOW()";\n\t\t$this->db->query($query);\n\t\t  ]]>\n\t\t  </add>\t\t  \n\t\t</operation>\n\t\t<operation error="skip"> \n\t\t\t<search ><![CDATA[$this->db->query("UPDATE `" . DB_PREFIX . "user` SET username = \'" . $this->db->escape($data[\'username\']) . "\', user_group_id = \'" . (int)$data[\'user_group_id\'] . "\', firstname = \'" . $this->db->escape($data[\'firstname\']) . "\', lastname = \'" . $this->db->escape($data[\'lastname\']) . "\', email = \'" . $this->db->escape($data[\'email\']) . "\', image = \'" . $this->db->escape($data[\'image\']) . "\', status = \'" . (int)$data[\'status\'] . "\' WHERE user_id = \'" . (int)$user_id . "\'");]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t  $this->load->model(\'user/user_group\');\n\t\t$user_group = $this->model_user_user_group->getUserGroup($data[\'user_group_id\']);\t\t\n\t\tif($user_group[\'name\']==\'Store admin\'){\n\t\t\t$store_id = $data[\'store_id\'];\n\t\t}else{\n\t\t\t$store_id = 0;\n\t\t}\n\t\t$this->db->query("UPDATE `" . DB_PREFIX . "user` SET username = \'" . $this->db->escape($data[\'username\']) . "\', user_group_id = \'" . (int)$data[\'user_group_id\'] . "\', store_id = \'" . $store_id . "\', firstname = \'" . $this->db->escape($data[\'firstname\']) . "\', lastname = \'" . $this->db->escape($data[\'lastname\']) . "\', email = \'" . $this->db->escape($data[\'email\']) . "\', image = \'" . $this->db->escape($data[\'image\']) . "\', status = \'" . (int)$data[\'status\'] . "\' WHERE user_id = \'" . (int)$user_id . "\'");\n\t\t]]>\n\t\t\t</add>\t\t  \n\t\t</operation>\n\t\t<operation error="skip"> \n\t\t\t<search ><![CDATA[$sql = "SELECT * FROM `" . DB_PREFIX . "user`";]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\t\tif($userac->user_group_name==\'Store admin\'){\n\t\t\t\t\t$sql = "SELECT * FROM `" . DB_PREFIX . "user` WHERE store_id=".$userac->store_id." AND user_group_id=".$userac->getGroupId();\n\t\t\t\t}else{\n\t\t\t\t\t$sql = "SELECT * FROM `" . DB_PREFIX . "user`";\n\t\t\t\t}\t\t\t\n\t\t\t]]>\n\t\t\t</add>\n\t\t</operation>\n\t\t<operation error="skip"> \n\t\t\t<search ><![CDATA[$query = $this->db->query("SELECT COUNT(*) AS total FROM `" . DB_PREFIX . "user`");]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\t\tif($userac->user_group_name==\'Store admin\'){\n\t\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total FROM `" . DB_PREFIX . "user` WHERE store_id=".$userac->store_id." AND user_group_id=".$userac->getGroupId());\n\t\t\t\t}else{\n\t\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total FROM `" . DB_PREFIX . "user`");\n\t\t\t\t}\t\t\t\n\t\t\t]]>\n\t\t\t</add>\n\t\t</operation>\n\t</file>\n\t<file path="system/library/cart/user.php">\n\t\t<operation error="skip"> \n\t\t\t<search ><![CDATA[$this->user_group_id = $user_query->row[\'user_group_id\'];]]></search>\n\t\t  <add position="after"><![CDATA[\n\t\t\tif(isset($user_query->row[\'store_id\'])&&strlen($user_query->row[\'store_id\'])>0){\n\t\t\t\t$this->store_id = $user_query->row[\'store_id\'];\n\t\t\t}\n\t\t\tif(isset($user_query->row[\'name\'])&&strlen($user_query->row[\'name\'])>0){\n\t\t\t\t$this->user_group_name = $user_query->row[\'name\'];\n\t\t\t}\n\t\t\t]]>\n\t\t  </add>\t\t  \n\t\t</operation>\n\t\t<operation error="skip"> \n\t\t\t<search ><![CDATA[$user_query = $this->db->query("SELECT * FROM " . DB_PREFIX . "user WHERE user_id = \'" . (int)$this->session->data[\'user_id\'] . "\' AND status = \'1\'");]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t\t$user_query = $this->db->query("SELECT u.*,ug.name FROM " . DB_PREFIX . "user u INNER JOIN " . DB_PREFIX . "user_group ug ON u.user_group_id = ug.user_group_id WHERE user_id = \'" . (int)$this->session->data[\'user_id\'] . "\' AND status = \'1\'");\n\t\t\t\t]]>\n\t\t\t</add>\t\t  \n\t\t</operation>\n\t\t<operation error="skip"> \n\t\t\t<search ><![CDATA[$user_query = $this->db->query("SELECT * FROM " . DB_PREFIX . "user WHERE username = \'" . $this->db->escape($username) . "\' AND (password = SHA1(CONCAT(salt, SHA1(CONCAT(salt, SHA1(\'" . $this->db->escape($password) . "\'))))) OR password = \'" . $this->db->escape(md5($password)) . "\') AND status = \'1\'");]]></search>\n\t\t\t<add position="replace"><![CDATA[\t\t\t\t\n\t\t\t\t$user_query = $this->db->query("SELECT u.*,ug.name FROM " . DB_PREFIX . "user u INNER JOIN " . DB_PREFIX . "user_group ug ON u.user_group_id = ug.user_group_id WHERE username = \'" . $this->db->escape($username) . "\' AND (password = SHA1(CONCAT(salt, SHA1(CONCAT(salt, SHA1(\'" . $this->db->escape($password) . "\'))))) OR password = \'" . $this->db->escape(md5($password)) . "\') AND status = \'1\'");\n\t\t\t\t]]>\n\t\t\t</add>\n\t\t</operation>\n\t</file>\t\t\n<!-- Filter product -->\t\n\t<file path="admin/controller/catalog/product.php">        \n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[\n\t\t\tprotected function getList() {\n\t\t\t]]></search>\n\t\t\t<add position="after"><![CDATA[ \n\t\t\t \n\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\tif($userac->user_group_name==\'Store admin\') {\n\t\t\t\t$filter_store = $userac->store_id;\n\t\t\t} else {\n\t\t\t\t$filter_store = null;\n\t\t\t}\n\t\t\t  ]]></add>\n\t\t</operation>  \n\t\t<operation error="skip">\n\t\t<search><![CDATA[\n\t\t $product_total = $this->model_catalog_product->getTotalProducts($filter_data);\n\t\t  ]]></search>\n\t\t<add position="before"><![CDATA[\n\t\t  $filter_data[\'filter_store\']   = $filter_store;\n\t\t  ]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t<search><![CDATA[\n\t\t  $data[\'products\'][] = array(\n\t\t  ]]></search>\n\t\t<add position="after"><![CDATA[\n\t\t  \'store\'      => $result[\'store_id\'],\n\t\t  ]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t<search><![CDATA[\n\t\t\tif (is_file(DIR_IMAGE . $result[\'image\'])) {\t\n\t\t  ]]></search>\n\t\t<add position="before"><![CDATA[\n\t\t  if(!isset($result[\'store_id\'])){\n          $result[\'store_id\'] = 0;\n                    }\n\t\t  ]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t  $data[\'filter_status\'] = $filter_status;\n\t\t\t  ]]></search>\n\t\t\t<add position="after"><![CDATA[\n\t\t\t  $data[\'filter_store\'] = $filter_store;\n\t\t\t  ]]></add>\n\t\t</operation>\n\t</file>\n\t<file path="admin/model/catalog/product.php">\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t\t$sql = "SELECT COUNT(DISTINCT p.product_id) AS total FROM " . DB_PREFIX . "product p LEFT JOIN " . DB_PREFIX . "product_description pd ON (p.product_id = pd.product_id)";\n\t\t\t]]></search>\n\t\t\t<add position="after"><![CDATA[\n\t\t\t$sql .= " LEFT JOIN " . DB_PREFIX . "product_to_store p2s ON (p.product_id = p2s.product_id)";\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t\tpublic function deleteProduct($product_id) {\n\t\t\t]]></search>\n\t\t\t<add position="after"><![CDATA[\n\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\tif($userac->user_group_name==\'Store admin\') {\n\t\t\t\t$query = $this->db->query("SELECT COUNT(store_id) AS total FROM " . DB_PREFIX . "product_to_store WHERE product_id = " . (int)$product_id);\n\t\t\t\t$row = $query->row;\t\t\t\t\n\t\t\t\tif($row[\'total\']>1){\n\t\t\t\t\t$this->db->query("DELETE FROM " . DB_PREFIX . "product_to_store WHERE product_id = \'" . (int)$product_id . "\' AND store_id=".$userac->store_id);\n\t\t\t\t\treturn;\n\t\t\t\t}\t\t\t\t\n\t\t\t}\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t\t$sql = "SELECT * FROM " . DB_PREFIX . "product p LEFT JOIN " . DB_PREFIX . "product_description pd ON (p.product_id = pd.product_id) WHERE pd.language_id = \'" . (int)$this->config->get(\'config_language_id\') . "\'";\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t\t$sql = "SELECT p.*,pd.* FROM " . DB_PREFIX . "product p LEFT JOIN " . DB_PREFIX . "product_description pd ON (p.product_id = pd.product_id)  LEFT JOIN " . DB_PREFIX . "product_to_store p2s ON (p.product_id = p2s.product_id) WHERE pd.language_id = \'" . (int)$this->config->get(\'config_language_id\') . "\'";\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\tif (isset($data[\'filter_status\']) && $data[\'filter_status\'] !== \'\') {\n\t\t\t]]></search>\n\t\t\t<add position="before"><![CDATA[\n\t\t\t\tif (isset($data[\'filter_store\'])) {\n\t\t\t\t\t$sql .= " AND p2s.store_id = \'".$data[\'filter_store\']."\'";\n\t\t\t\t}\n\t\t\t]]></add>\n\t\t</operation>\n\t</file>\t\n\t<!-- Add/Edit/Delete product\t-->\t\n\t<file path="admin/controller/catalog/product.php">\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\tprotected function getForm() {\n\t\t\t]]></search>\n\t\t\t<add position="after"><![CDATA[\n\t\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\t\t$data[\'user_group_name\'] = $userac->user_group_name;\t\t\t\t\t\t\t\t\n\t\t\t\t$data[\'user_store_id\'] = $userac->store_id;\t\t\t\t\t\t\t\t\n\t\t\t]]></add>\n\t\t</operation>\n\t</file>\n\t<file path="admin/view/template/catalog/product_form.twig">\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t<label class="col-sm-2 control-label">{{ entry_store }}</label>\n\t\t\t]]></search>\n\t\t\t<add position="before"><![CDATA[\n\t\t\t\t{% if user_group_name==\'Store admin\'%}\n\t\t\t\t\t<input type="checkbox" style="display:none" name="product_store[]" value="{{user_store_id}}" checked="checked" /><!--\n\t\t\t\t{% endif %}\t\t\t\t\t\n\t\t\t]]></add>\n\t\t</operation>\t\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t<label class="col-sm-2 control-label" for="input-download"><span data-toggle="tooltip" title="{{ help_download }}">{{ entry_download }}</span></label>\n\t\t\t]]></search>\n\t\t\t<add position="before"><![CDATA[\n\t\t\t{% if user_group_name==\'Store admin\'%}\n\t\t\t\t-->\n\t\t\t{% endif %}\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t<td class="text-left">{{ store.name }}</td>\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t<td {% if user_group_name==\'Store admin\' and store.store_id!=user_store_id %} style="display:none"{% endif %} class="text-left">{{ store.name }}</td>\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t<td class="text-left"><select name="product_layout[{{ store.store_id }}]" class="form-control">\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t<td {% if user_group_name==\'Store admin\' and store.store_id!=user_store_id %} style="display:none" {% endif %}> class="text-left"><select name="product_layout[{{ store.store_id }}]" class="form-control">\n\t\t\t]]></add>\n\t\t</operation>\t\t\n\t</file>\n\t<!-- Filter order -->\t\n\t<file path="admin/model/sale/order.php">\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\tif (!empty($data[\'filter_order_id\'])) {\n\t\t\t]]></search>\n\t\t\t<add position="before"><![CDATA[\n\t\t\t$userac = $this->registry->get(\'user\');\t\n\t\t\tif($userac->user_group_name==\'Store admin\') {\n\t\t\t\t$sql .= " AND store_id=".$userac->store_id;\t\t\t\t\n\t\t\t}\t\t\t\n\t\t  ]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t\tpublic function getOrder($order_id) {\n\t\t\t]]></search>\n\t\t\t<add position="before"><![CDATA[\n\t\t\tpublic function checkOrderForStore($order_id){\n\t\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\t\tif($userac->user_group_name==\'Store admin\') {\t\t\t\t\n\t\t\t\t\t$sql = "SELECT count(order_id) as total FROM " . DB_PREFIX . "order o WHERE o.order_id=$order_id AND o.store_id=".$userac->store_id;\n\t\t\t\t\t$result = $this->db->query($sql)->row;\n\t\t\t\t\tif($result[\'total\']==0){\n\t\t\t\t\t\treturn false;\n\t\t\t\t\t}else{\n\t\t\t\t\t\treturn true;\n\t\t\t\t\t}\t\t\t\n\t\t\t\t}else{\n\t\t\t\t\treturn true;\n\t\t\t\t}\n\t\t\t}\n\t\t\t]]></add>\n\t\t</operation>\t\t\n\t</file>\n\t<!-- Add/Edit Order -->\n\t<file path="admin/language/en-gb/sale/order.php">\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t\t// Error\n\t\t\t]]></search>\n\t\t\t<add position="after"><![CDATA[\n\t\t\t$_[\'error_not_found\']        = \'Warning: Order not found!\';\n\t\t\t]]></add>\n\t\t</operation>\n\t</file>\t\n\t<file path="admin/controller/sale/order.php">\t\t\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[\n\t\t\t$order_info = $this->model_sale_order->getOrder($this->request->get[\'order_id\']);\n\t\t\t]]></search>\n\t\t\t<add position="before"><![CDATA[ \n\t\t\tif(!$this->model_sale_order->checkOrderForStore($this->request->get[\'order_id\'])){\n\t\t\t\t$this->session->data[\'error\'] = $this->language->get(\'error_not_found\');\n\t\t\t\t$this->response->redirect($this->url->link(\'sale/order\', \'user_token=\' . $this->session->data[\'user_token\'] . $url, true));\n\t\t\t}]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[\n\t\t\t$data[\'error_warning\'] = \'\';\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\tif (isset($this->session->data[\'error\'])) {\n\t\t\t\t$data[\'error_warning\'] = $this->session->data[\'error\'];\n\n\t\t\t\tunset($this->session->data[\'error\']);\n\t\t\t} else {\n\t\t\t\t$data[\'error_warning\'] = \'\';\n\t\t\t}\n\t\t]]></add>\n\t\t</operation>\t\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\tpublic function getForm() {\n\t\t\t]]></search>\n\t\t\t<add position="after"><![CDATA[\n\t\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\t\t$data[\'user_group_name\'] = $userac->user_group_name;\n\t\t\t\t$data[\'user_store_id\'] = $userac->store_id;\n\t\t\t]]></add>\n\t\t</operation>\n\t</file>\n\t<file path="admin/view/template/sale/order_form.twig">\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\t\t\t\n\t\t\t<label class="col-sm-2 control-label" for="input-store">{{ entry_store }}</label>\n\t\t\t]]></search>\n\t\t\t<add position="before"><![CDATA[\n\t\t\t{% if user_group_name==\'Store admin\'%}\n\t\t\t\t\t<div style="display:none">\n\t\t\t{% endif %}\t\t\t\n\t\t  ]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t<label class="col-sm-2 control-label" for="input-currency">{{ en