registry->get(\'user\');\t\t\n\t\t\t\tif($userac->user_group_name==\'Store admin\') {\t\t\t\t\n\t\t\t\t\t$sql = "SELECT count(information_id) as total FROM " . DB_PREFIX . "information_to_store i2s WHERE i2s.information_id=$information_id AND i2s.store_id=".$userac->store_id;\n\t\t\t\t\t$result = $this->db->query($sql)->row;\n\t\t\t\t\tif($result[\'total\']==0){\n\t\t\t\t\t\treturn false;\n\t\t\t\t\t}else{\n\t\t\t\t\t\treturn true;\n\t\t\t\t\t}\t\t\t\n\t\t\t\t}else{\n\t\t\t\t\treturn true;\n\t\t\t\t}\n\t\t\t}\n\t\t\t]]></add>\n\t\t</operation>\n\t</file>\n\t<file path="admin/model/catalog/product.php">\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t\tpublic function getProduct($product_id) {\n\t\t\t]]></search>\n\t\t\t<add position="before"><![CDATA[\n\t\t\tpublic function checkProductForStore($product_id){\n\t\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\t\tif($userac->user_group_name==\'Store admin\') {\t\t\t\t\n\t\t\t\t\t$sql = "SELECT count(product_id) as total FROM " . DB_PREFIX . "product_to_store p2s WHERE p2s.product_id=$product_id AND p2s.store_id=".$userac->store_id;\n\t\t\t\t\t$result = $this->db->query($sql)->row;\n\t\t\t\t\tif($result[\'total\']==0){\n\t\t\t\t\t\treturn false;\n\t\t\t\t\t}else{\n\t\t\t\t\t\treturn true;\n\t\t\t\t\t}\t\t\t\n\t\t\t\t}else{\n\t\t\t\t\treturn true;\n\t\t\t\t}\n\t\t\t}\n\t\t\t]]></add>\n\t\t</operation>\n\t</file>\n\t\n\t<file path="admin/model/catalog/category.php">\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t\tpublic function getCategory($category_id) {\n\t\t\t]]></search>\n\t\t\t<add position="before"><![CDATA[\n\t\t\tpublic function checkCategoryForStore($category_id){\n\t\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\t\tif($userac->user_group_name==\'Store admin\') {\t\t\t\t\n\t\t\t\t\t$sql = "SELECT count(category_id) as total FROM " . DB_PREFIX . "category_to_store c2s WHERE c2s.category_id=$category_id AND c2s.store_id=".$userac->store_id;\n\t\t\t\t\t$result = $this->db->query($sql)->row;\n\t\t\t\t\tif($result[\'total\']==0){\n\t\t\t\t\t\treturn false;\n\t\t\t\t\t}else{\n\t\t\t\t\t\treturn true;\n\t\t\t\t\t}\t\t\t\n\t\t\t\t}else{\n\t\t\t\t\treturn true;\n\t\t\t\t}\n\t\t\t}\n\t\t\t]]></add>\n\t\t</operation>\n\t\t\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t\tpublic function deleteCategory($category_id) {\n\t\t\t]]></search>\n\t\t\t<add position="after"><![CDATA[\n\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\tif($userac->user_group_name==\'Store admin\'){\n\t\t\t\t$query = $this->db->query("SELECT COUNT(store_id) AS total FROM " . DB_PREFIX . "category_to_store WHERE category_id = " . (int)$category_id);\n\t\t\t\t$row = $query->row;\n\t\t\t\tif($row[\'total\']>1){\n\t\t\t\t\t$this->db->query("DELETE FROM " . DB_PREFIX . "category_to_store WHERE category_id = \'" . (int)$category_id . "\' AND store_id=".$userac->store_id);\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t}\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t$sql = "SELECT cp.category_id AS category_id, GROUP_CONCAT(cd1.name ORDER BY cp.level SEPARATOR \'&nbsp;&nbsp;&gt;&nbsp;&nbsp;\') AS name, c1.parent_id, c1.sort_order FROM " . DB_PREFIX . "category_path cp LEFT JOIN " . DB_PREFIX . "category c1 ON (cp.category_id = c1.category_id) LEFT JOIN " . DB_PREFIX . "category c2 ON (cp.path_id = c2.category_id) LEFT JOIN " . DB_PREFIX . "category_description cd1 ON (cp.path_id = cd1.category_id) LEFT JOIN " . DB_PREFIX . "category_description cd2 ON (cp.category_id = cd2.category_id) WHERE cd1.language_id = \'" . (int)$this->config->get(\'config_language_id\') . "\' AND cd2.language_id = \'" . (int)$this->config->get(\'config_language_id\') . "\'";\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t\t$sql = "SELECT cp.category_id AS category_id, GROUP_CONCAT(DISTINCT cd1.name ORDER BY cp.level SEPARATOR \'&nbsp;&nbsp;&gt;&nbsp;&nbsp;\') AS name, c1.parent_id, c1.sort_order FROM " . DB_PREFIX . "category_path cp \n\t\t\t\tLEFT JOIN " . DB_PREFIX . "category c1 ON (cp.category_id = c1.category_id) \n\t\t\t\tLEFT JOIN " . DB_PREFIX . "category c2 ON (cp.path_id = c2.category_id) \n\t\t\t\tLEFT JOIN " . DB_PREFIX . "category_description cd1 ON (cp.path_id = cd1.category_id) \n\t\t\t\tLEFT JOIN " . DB_PREFIX . "category_description cd2 ON (cp.category_id = cd2.category_id) \n\t\t\t\tINNER JOIN " . DB_PREFIX . "category_to_store c2s ON (cp.category_id = c2s.category_id)\t\t\t\t\n\t\t\t\tWHERE cd1.language_id = \'" . (int)$this->config->get(\'config_language_id\') . "\' AND cd2.language_id = \'" . (int)$this->config->get(\'config_language_id\') . "\'";\n\t\t  ]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total FROM " . DB_PREFIX . "category");\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t\t$sql = "SELECT COUNT(DISTINCT c.category_id) AS total FROM " . DB_PREFIX . "category c\n\t\t\t\tINNER JOIN " . DB_PREFIX . "category_to_store c2s ON (c.category_id = c2s.category_id)";\n\n\t\t\t\t \n\t\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\t\tif($userac->user_group_name==\'Store admin\') {\n\t\t\t\t\t$sql .= " WHERE c2s.store_id = $userac->store_id";\n\t\t\t\t} \t\t\t\t\n\t\t\t\t$query = $this->db->query($sql);\n\t\t  ]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\tif (!empty($data[\'filter_name\'])) {\n\t\t\t]]></search>\n\t\t\t<add position="before"><![CDATA[\n\t\t  if (!empty($data[\'filter_store\'])) {\n\t\t\t$sql .= " AND c2s.store_id = \'" . (int)$data[\'filter_store\'] . "\'";\n\t\t}\n\t\t  ]]></add>\n\t\t</operation>\n\t</file>\n\t<file path="admin/language/en-gb/catalog/product.php">\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t\t// Error\n\t\t\t]]></search>\n\t\t\t<add position="after"><![CDATA[\n\t\t\t$_[\'error_not_found\']        = \'Warning: Product not found!\';\n\t\t\t]]></add>\n\t\t</operation>\n\t</file>\n\t\n\t<file path="admin/controller/catalog/product.php">\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[\n\t\t\t$product_info = $this->model_catalog_product->getProduct($this->request->get[\'product_id\']);\n\t\t\t]]></search>\n\t\t\t<add position="before"><![CDATA[ \n\t\t\tif(!$this->model_catalog_product->checkProductForStore($this->request->get[\'product_id\'])){\n\t\t\t\t$this->session->data[\'error\'] = $this->language->get(\'error_not_found\');\n\t\t\t\t$this->response->redirect($this->url->link(\'catalog/product\', \'user_token=\' . $this->session->data[\'user_token\'] . $url, true));\n\t\t\t}]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[\n\t\t\t$data[\'error_warning\'] = \'\';\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\tif (isset($this->session->data[\'error\'])) {\n\t\t\t\t$data[\'error_warning\'] = $this->session->data[\'error\'];\n\n\t\t\t\tunset($this->session->data[\'error\']);\n\t\t\t} else {\n\t\t\t\t$data[\'error_warning\'] = \'\';\n\t\t\t}\n\t\t]]></add>\n\t\t</operation>\t\t\n\t</file>\n\t<file path="admin/language/en-gb/catalog/information.php">\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t\t// Error\n\t\t\t]]></search>\n\t\t\t<add position="after"><![CDATA[\n\t\t\t$_[\'error_not_found\']        = \'Warning: Information not found!\';\n\t\t\t]]></add>\n\t\t</operation>\n\t</file>\n\t\n\t<file path="admin/controller/catalog/information.php">\n\t\t<operation error="skip">\n\t\t\t<search ><![CDATA[\n\t\t\t$information_info = $this->model_catalog_information->getInformation($this->request->get[\'information_id\']);\n\t\t\t]]></search>\n\t\t\t<add position="before"><![CDATA[ \n\t\t\tif(!$this->model_catalog_information->checkInformationForStore($this->request->get[\'information_id\'])){\n\t\t\t\t$this->session->data[\'error\'] = $this->language->get(\'error_not_found\');\n\t\t\t\t$this->response->redirect($this->url->link(\'c