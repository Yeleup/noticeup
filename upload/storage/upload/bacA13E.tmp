->db->query("SELECT COUNT(*) AS total FROM " . DB_PREFIX . "information");\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t$userac = $this->registry->get(\'user\');\t\t\n\t\t\tif($userac->user_group_name==\'Store admin\') {\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total FROM " . DB_PREFIX . "information INNER JOIN " . DB_PREFIX . "information_to_store WHERE store_id = ".$userac->store_id);\n\t\t\t} else {\n\t\t\t\t$query = $this->db->query("SELECT COUNT(*) AS total FROM " . DB_PREFIX . "information");\n\t\t\t}\t\t\t\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t\t$sql = "SELECT * FROM " . DB_PREFIX . "information i LEFT JOIN " . DB_PREFIX . "information_description id ON (i.information_id = id.information_id) WHERE id.language_id = \'" . (int)$this->config->get(\'config_language_id\') . "\'";\n\t\t\t]]></search>\n\t\t\t<add position="replace"><![CDATA[\n\t\t\t\t$sql = "SELECT distinct(i.information_id),i.*,id.* FROM " . DB_PREFIX . "information i\n\t\t\t\t\t\tLEFT JOIN " . DB_PREFIX . "information_description id ON (i.information_id = id.information_id) \n\t\t\t\t\t\tLEFT JOIN " . DB_PREFIX . "information_to_store i2s ON (i2s.information_id = id.information_id)\n\t\t\t\t\t\tWHERE id.language_id = \'" . (int)$this->config->get(\'config_language_id\') . "\'";\n\t\t\t\t\n\t\t\t]]></add>\n\t\t</operation>\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\t\t$sort_data = array(\n\t\t\t]]></search>\n\t\t\t<add position="before"><![CDATA[\n\t\t\t\tif (isset($data[\'filter_store\'])) {\n\t\t\t\t\t$sql .= " AND i2s.store_id = \'".$data[\'filter_store\']."\'";\n\t\t\t\t}\t\t\t\t\n\t\t\t]]></add>\n\t\t</operation>\n\t</file>\n\t<!-- Add/Edit/Delete Information\t-->\t\n\t<file path="admin/controller/catalog/information.php">\n\t\t<operation error="skip">\n\t\t\t<search><![CDATA[\n\t\t\tprotected function getForm() {\n\t\t\t]]></search>\n\t\t\t<add position="after"><![CDATA[\n\t\t\t\t