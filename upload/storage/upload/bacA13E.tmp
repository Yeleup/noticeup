 &quot;order` o ON o.customer_id = c.customer_id\r\n\t\t\t\tWHERE YEAR(c.date_added) = YEAR(NOW()) AND o.store_id=&quot;.$userac-&gt;store_id.&quot; GROUP BY MONTH(c.date_added)&quot;);\r\n\t\t\t} else {\r\n\t\t\t\t$query = $this-&gt;db-&gt;query(&quot;SELECT COUNT(*) AS total, date_added FROM `&quot; . DB_PREFIX . &quot;customer` WHERE YEAR(date_added) = YEAR(NOW()) GROUP BY MONTH(date_added)&quot;);\r\n\t\t\t}\r\n\t\t\t]]&gt;&lt;/add&gt;\r\n\t\t&lt;/operation&gt;\r\n\t\t&lt;operation error=&quot;skip&quot;&gt;\r\n\t\t\t&lt;search &gt;&lt;![CDATA[\r\n\t\t\tif (!empty($data[\'filter_order_status_id\'])) {\r\n\t\t\t]]&gt;&lt;/search&gt;\r\n\t\t\t&lt;add position=&quot;before&quot;&gt;&lt;![CDATA[\t\t\t \r\n\t\t\t$userac = $this-&gt;registry-&gt;get(\'user\');\t\t\r\n\t\t\tif($userac-&gt;user_group_name==\'Store admin\') {\t\t\t\t\r\n\t\t\t\t$sql .= &quot; AND o.store_id=&quot;.$userac-&gt;store_id;\r\n\t\t\t}\r\n\t\t\t]]&gt;&lt;/add&gt;\r\n\t\t&lt;/operation&gt;\r\n\t&lt;/file&gt;\t\r\n\t&lt;!-- Manage user --&gt;\r\n\t&lt;file path=&quot;admin/view/template/user/user_form.twig&quot;&gt;\t\r\n\t\t&lt;operation error=&quot;skip&quot;&gt; \r\n\t\t\t&lt;search index=&quot;0&quot;&gt;&lt;![CDATA[&lt;div class=&quot;form-group&quot;&gt;]]&gt;&lt;/search&gt;\r\n\t\t\t&lt;add position=&quot;replace&quot;&gt;&lt;![CDATA[\r\n\t\t\t\t{% if user_group_name==\'Store admin\'%}\r\n\t\t\t\t\t&lt;div class=&quot;form-group&quot; style=&quot;display:none;&quot;&gt;\r\n\t\t\t\t{% else %}\r\n\t\t\t\t\t&lt;div class=&quot;form-group&quot;&gt;\r\n\t\t\t\t{% endif %}\r\n\t\t\t]]&gt;\r\n\t\t\t&lt;/add&gt;\t\t  \r\n\t\t&lt;/operation&gt;\r\n\t\t&lt;operation error=&quot;skip&quot;&gt; \r\n\t\t\t&lt;search index=&quot;0&quot;&gt;&lt;![CDATA[&lt;option value=&quot;{{ user_group.user_group_id }}&quot;&gt;{{ user_group.name }}&lt;/option&gt;]]&gt;&lt;/search&gt;\r\n\t\t\t&lt;add position=&quot;replace&quot;&gt;&lt;![CDATA[\r\n\t\t\t\t{% if user_group_name==\'Store admin\'%}\r\n\t\t\t\t\t{% if user_group.name==\'Store admin\' %}\r\n\t\t\t\t\t\t&lt;option value=&quot;{{ user_group.user_group_id }}&quot; selected=&quot;selected&quot;&gt;{{ user_group.name }}&lt;/option&gt;\r\n\t\t\t\t\t{% endif %}\t\r\n\t\t\t\t{% else %}\r\n\t\t\t\t\t&lt;option value=&quot;{{ user_group.user_group_id }}&quot;&gt;{{ user_group.name }}&lt;/option&gt;\r\n\t\t\t\t{% endif %}\r\n\t\t\t]]&gt;\r\n\t\t\t&lt;/add&gt;\t\t  \r\n\t\t&lt;/operation&gt;\r\n\t\t&lt;operation error=&quot;skip&quot;&gt; \r\n\t\t\t&lt;search&gt;&lt;![CDATA[&lt;label class=&quot;col-sm-2 control-label&quot; for=&quot;input-user-group&quot;&gt;{{entry_store}}&lt;/label&gt;]]&gt;&lt;/search&gt;\r\n\t\t\t&lt;add position=&quot;replace&quot;&gt;&lt;![CDATA[\r\n\t\t\t\t{% if user_group_name==\'Store admin\'%}\r\n\t\t\t\t\t&lt;label style=&quot;display:none;&quot; class=&quot;col-sm-2 control-label&quot; for=&quot;input-user-group&quot;&gt;{{entry_store}}&lt;/label&gt;\t\r\n\t\t\t\t{% else %}\r\n\t\t\t\t\t&lt;label class=&quot;col-sm-2 control-label&quot; for=&quot;input-user-group&quot;&gt;{{entry_store}}&lt;/label&gt;\r\n\t\t\t\t{% endif %}\r\n\t\t\t]]&gt;\r\n\t\t\t&lt;/add&gt;\t\t  \r\n\t\t&lt;/operation&gt;\r\n\t\t&lt;operation error=&quot;skip&quot;&gt; \r\n\t\t\t&lt;search index=&quot;2&quot;&gt;&lt;![CDATA[&lt;div class=&quot;col-sm-10&quot;&gt;]]&gt;&lt;/search&gt;\r\n\t\t\t&lt;add position=&quot;replace&quot;&gt;&lt;![CDATA[\r\n\t\t\t\t{% if user_group_name==\'Store admin\'%}\r\n\t\t\t\t\t&lt;div style=&quot;display:none;&quot; class=&quot;col-sm-10&quot;&gt;\r\n\t\t\t\t{% else %}\r\n\t\t\t\t\t&lt;div class=&quot;col-sm-10&quot;&gt;\r\n\t\t\t\t{% endif %}\r\n\t\t\t]]&gt;\r\n\t\t\t&lt;/add&gt;\t\t  \r\n\t\t&lt;/operation&gt;\t\t\r\n\t&lt;/file&gt;\r\n&lt;/modification&gt;\r\n', '&lt;?php\r\nclass {event_class} extends Controller\r\n{\r\n    /**\r\n     * @trigger  catalog/controller/commmon/footer/before\r\n     * @action   {event_path}/foo\r\n     * @order    1\r\n     */\r\n    public function foo(&amp;$route, &amp;$data)\r\n    {\r\n        // Your code here..\r\n    }\r\n\r\n    /**\r\n     * @trigger  catalog/view/common/footer/after\r\n     * @action   {event_path}/bar\r\n     * @order    2\r\n     */\r\n    public function bar(&amp;$route, &amp;$data, &amp;$output)\r\n    {\r\n        // Your code here..\r\n    }\r\n}', '{"customer_group":"0","customer_group_ids":[]}', '{"author":"magzhan9292","note":"","editor":{"controller":0,"model":0,"template":0,"modification":"1","event":0}}', '1', '2020-08-19 00:00:00', '0000-00-00 00:00:00', '2020-08-19 18:15:37', '2020-08-28 17:54:42');


